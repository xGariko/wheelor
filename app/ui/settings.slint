// Finestra delle impostazioni di Wheelor.
// Slint è dichiarativo: si descrive COME deve apparire l'interfaccia in base alle proprietà,
// e si aggiorna da sola quando le proprietà cambiano (dal codice Rust o dall'utente).
//
// Quattro pagine: Ruote (cosa mostra ogni ruota), Libreria (tutte le azioni salvate), Generale
// e Informazioni. I dati veri stanno in Rust: qui arrivano già pronti da mostrare (le "righe").
//
// Aspetto: quello del sito (web/src/style.css), tema scuro. Campi di testo e menu a tendina
// restano i widget standard (stile Fluent, forzato in scuro); pulsanti, interruttori, righe e
// finestre di dialogo sono disegnati qui, con piccole animazioni sui cambi di stato.
//
// Griglia: ogni pagina è una colonna con margini di 32 px e larghezza massima; le sezioni
// distano 32 px; pulsanti e campi sono tutti alti 32 px, così stanno allineati sulla stessa riga.
// Testo: 14 px di base, 13 per le spiegazioni, mai sotto i 12.

import { AboutSlint, LineEdit, ComboBox, TextEdit, ScrollView, ListView, Palette } from "std-widgets.slint";

// Impostato da Rust all'avvio: Segoe Fluent Icons su Windows 11, Segoe MDL2 Assets su Windows 10.
export global Fonts {
    in property <string> icons: "Segoe Fluent Icons";
}

// La palette del sito. Il colore di accento è una preferenza: lo imposta Rust (vedi
// `config::Accent`); qui i valori predefiniti, l'acqua del logo.
export global Theme {
    out property <color> bg: #081314;
    out property <color> sidebar: #0A1718;
    out property <color> raised: #0E1E20;  // finestre di dialogo
    out property <color> disc: #0B191A;  // il disco della ruota
    out property <color> card: #A5CECD0A;
    out property <color> card-border: #A5CECD1F;
    out property <color> line: #A5CECD1A;
    out property <color> line-strong: #A5CECD2E;
    out property <color> hover: #A5CECD14;
    out property <color> press: #A5CECD24;
    out property <color> text: #E9F5F4;
    out property <color> heading: #EEF7F6;
    out property <color> body: #A3BCBA;
    out property <color> soft: #B9D3D1;
    out property <color> faint: #8AA3A1;
    in-out property <color> accent: #6FE0E6;
    in-out property <color> accent-hover: #8FE9EE;
    in-out property <color> accent-press: #5CCBD1;
    in-out property <color> on-accent: #06191B;
    in-out property <color> star-light: #83EAF0;
    in-out property <color> star-dark: #49C8CE;
    // Velature dell'accento: sfondo di ciò che è selezionato e bordi accesi.
    out property <color> accent-soft: self.accent.with-alpha(0.14);
    out property <color> accent-line: self.accent-hover.with-alpha(0.4);
    out property <color> danger: #FF8A8E;
    out property <color> danger-hover: #FFA5A8;
    out property <color> danger-soft: #FF8A8E1F;
    out property <color> danger-line: #FF8A8E59;
    out property <color> on-danger: #2A0809;
    out property <color> ball: #CFE4E4;  // tinta media del gradiente delle palline
    out property <color> on-ball: #0E2A2C;
    out property <color> scrim: #020809B8;

    // Misure comuni.
    out property <length> control: 32px;  // altezza di pulsanti e campi
    out property <length> margin: 32px;  // margini delle pagine e distanza tra le sezioni
    out property <length> title-bar: 44px;  // la barra del titolo, sopra le pagine
    out property <length> radius: 14px;

    // Durate: brevi per i cambi di stato, un po' più lunghe per ciò che si sposta.
    out property <duration> quick: 120ms;
    out property <duration> smooth: 220ms;
}

// Il trascinamento in corso (palline della ruota, passi): lo imposta chi viene
// trascinato, lo disegna `Ghost` sopra a tutto. La posizione è nelle coordinate della finestra.
global Drag {
    in-out property <bool> active;
    in-out property <string> glyph;
    in-out property <string> initial;
    in-out property <string> label;
    in-out property <bool> removing;  // rilasciando qui, l'elemento viene tolto
    in-out property <length> x;
    in-out property <length> y;

    // Distanza oltre la quale una pressione diventa un trascinamento (sotto, è un clic).
    out property <length> threshold: 6px;
}

// Un'azione nell'elenco della libreria.
export struct ActionRow {
    id: string,
    label: string,
    glyph: string,   // carattere dell'icona, calcolato in Rust
    detail: string,  // riassunto di cosa fa, es. "Apri · wt.exe"
}

// Una ruota nella colonna di sinistra.
export struct WheelRow {
    id: string,
    name: string,
    glyph: string,
    detail: string,  // "Ruota principale", "Profilo · code.exe", "Sottomenu di …"
}

// Un elemento della ruota selezionata.
export struct SlotRow {
    label: string,
    glyph: string,
    initial: string,  // iniziale dell'etichetta, mostrata se manca l'icona
    submenu: bool,
    detail: string,  // cosa fa, es. "Apri · wt.exe" o "Sottomenu · 6 elementi"
}

// Una voce della finestra «Aggiungi» della ruota: un'azione della libreria o un'altra ruota.
export struct PaletteItem {
    id: string,
    glyph: string,
    initial: string,
    label: string,
    detail: string,
    submenu: bool,
    used: bool,  // già nella ruota
}

// Un passo dell'azione selezionata, come appare nell'elenco.
export struct StepRow {
    glyph: string,
    title: string,  // il tipo, es. "Apri"
    summary: string,  // cosa fa, es. "wt.exe"
}

// Una scelta con icona: tipi di passo, operazioni su finestre e sistema, esempi.
export struct Choice {
    glyph: string,
    label: string,
    hint: string,
}

// Una voce della finestra di scelta (azioni, sottomenu o app).
export struct PickItem {
    id: string,
    glyph: string,
    label: string,
    detail: string,
}

export struct IconData {
    code: string,
    glyph: string,
    name: string,
}

// Un colore di accento tra cui scegliere.
export struct AccentChoice {
    name: string,
    color: color,
}

// Tono di un pulsante.
enum Tone { plain, primary, danger, destructive }

// ── Elementi di base ─────────────────────────────────────────────────────────

component Glyph inherits Text {
    font-family: Fonts.icons;
    horizontal-alignment: center;
    vertical-alignment: center;
    color: Theme.text;
}

// La stella del logo, con il gradiente radiale di logo.svg.
component Star inherits Path {
    viewbox-x: 672;
    viewbox-y: 596;
    viewbox-width: 686;
    viewbox-height: 838;
    commands: "M672 1015C672 1015 831.182 990.037 903.5 925.5C1004.86 835.05 1015 596 1015 596C1015 596 1025.14 835.05 1126.5 925.5C1198.82 990.037 1358 1015 1358 1015C1358 1015 1198.82 1039.96 1126.5 1104.5C1025.14 1194.95 1015 1434 1015 1434C1015 1434 1004.86 1194.95 903.5 1104.5C831.182 1039.96 672 1015 672 1015Z";
    fill: @radial-gradient(circle, Theme.star-light 0%, Theme.star-dark 100%);
}

// Il logo di Wheelor (assets/logo.svg) ricostruito con elementi Slint:
// otto cerchi su un anello e la stella centrale, nitidi a qualsiasi dimensione.
component Logo inherits Rectangle {
    property <float> k: self.width / 2030px;  // scala: il logo originale è 2030×2030
    // Cerchi come Path: il renderer software dei provini non ritaglia i gradienti con border-radius.
    for i in 8: Path {
        width: 519.58px * root.k;
        height: self.width;
        x: (1015 + 755.21 * cos(180deg + i * 45deg) - 259.79) * root.k * 1px;
        y: (1015 + 755.21 * sin(180deg + i * 45deg) - 259.79) * root.k * 1px;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M0 50A50 50 0 1 0 100 50A50 50 0 1 0 0 50Z";
        fill: Theme.ball;
    }
    Star {
        x: 672px * root.k;
        y: 596px * root.k;
        width: 686px * root.k;
        height: 838px * root.k;
    }
}

// Il segno di gabrieleiovino.it, lo stesso del sito (web/src/partials/footer.html): la "g" del
// colore dei titoli, il punto color tabacco. Si dà l'altezza, la larghezza segue (65×138).
component AuthorMark inherits Rectangle {
    width: self.height * 65 / 138;
    accessible-role: none;
    Path {
        width: root.width;
        height: root.height;
        viewbox-width: 65;
        viewbox-height: 138;
        fill-rule: evenodd;
        fill: Theme.heading;
        commands: "M65 60.0607C65 78.1117 50.4493 92.7449 32.5 92.7449C14.5507 92.7449 0 78.1117 0 60.0607C0 42.0097 14.5507 27.3765 32.5 27.3765C50.4493 27.3765 65 42.0097 65 60.0607ZM14.5248 60.0607C14.5248 70.0444 22.5726 78.1378 32.5 78.1378C42.4274 78.1378 50.4752 70.0444 50.4752 60.0607C50.4752 50.077 42.4274 41.9837 32.5 41.9837C22.5726 41.9837 14.5248 50.077 14.5248 60.0607Z";
    }
    Path {
        width: root.width;
        height: root.height;
        viewbox-width: 65;
        viewbox-height: 138;
        fill: Theme.heading;
        commands: "M63.8889 105.595C64.5025 105.595 65.002 106.096 64.9807 106.712C64.8466 110.587 64.0163 114.409 62.5261 117.996C60.8928 121.927 58.4989 125.5 55.481 128.509C52.4631 131.518 48.8803 133.905 44.9372 135.533C40.9941 137.162 36.768 138 32.5 138C28.232 138 24.0059 137.162 20.0628 135.533C16.1197 133.905 12.5369 131.518 9.51903 128.509C6.50112 125.5 4.10719 121.927 2.47391 117.996C0.983711 114.409 0.153361 110.587 0.0193199 106.712C-0.00201796 106.096 0.497461 105.595 1.11111 105.595H13.4137C14.0273 105.595 14.5212 106.096 14.5597 106.712C14.6832 108.684 15.1329 110.624 15.8931 112.454C16.7964 114.628 18.1205 116.604 19.7896 118.268C21.4588 119.933 23.4403 121.253 25.6212 122.153C27.802 123.054 30.1395 123.518 32.5 123.518C34.8605 123.518 37.198 123.054 39.3788 122.153C41.5597 121.253 43.5412 119.933 45.2104 118.268C46.8795 116.604 48.2036 114.628 49.1069 112.454C49.8671 110.624 50.3168 108.684 50.4403 106.712C50.4788 106.096 50.9727 105.595 51.5863 105.595H63.8889Z";
    }
    Path {
        width: root.width;
        height: root.height;
        viewbox-width: 65;
        viewbox-height: 138;
        fill: Theme.heading;
        commands: "M50.5556 28.4939C50.5556 27.8768 51.053 27.3765 51.6667 27.3765H63.8889C64.5025 27.3765 65 27.8768 65 28.4939V91.6275C65 92.2447 64.5025 92.7449 63.8889 92.7449H51.6667C51.053 92.7449 50.5556 92.2447 50.5556 91.6275V28.4939Z";
    }
    Path {
        width: root.width;
        height: root.height;
        viewbox-width: 65;
        viewbox-height: 138;
        fill: #C9A27E;
        commands: "M65 7.26316C65 11.2745 61.7665 14.5263 57.7778 14.5263C53.7891 14.5263 50.5556 11.2745 50.5556 7.26316C50.5556 3.25183 53.7891 0 57.7778 0C61.7665 0 65 3.25183 65 7.26316Z";
    }
}

// Testo di spiegazione sotto un titolo o un campo.
component Hint inherits Text {
    font-size: 13px;
    color: Theme.body;
    wrap: word-wrap;
}

// Piccola etichetta in maiuscolo sopra un gruppo, come gli "eyebrow" del sito.
component Eyebrow inherits Text {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.2px;
    color: Theme.faint;
}

// Pastiglia con un numero o una parola, es. "3 di 8".
component Chip inherits Rectangle {
    in property <string> text;
    width: label.preferred-width + 18px;
    height: 22px;
    border-radius: 11px;
    background: Theme.hover;
    label := Text {
        text: root.text;
        font-size: 12px;
        font-weight: 600;
        color: Theme.soft;
    }
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.line;
}

// Riquadro con il bordo sottile, come le schede "Come funziona" del sito.
component Card inherits Rectangle {
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.card-border;
    border-radius: Theme.radius;
}

// Menu dei segnaposto: un clic ne aggiunge uno in fondo al campo (`insert`). Al momento
// dell'azione Wheelor li sostituisce con il loro valore (vedi actions/placeholders.rs).
component PlaceholderMenu {
    callback insert(string);

    property <[{label: string, token: string}]> items: [
        { label: @tr("Testo selezionato"), token: "{selection}" },
        { label: @tr("Testo negli appunti"), token: "{clipboard}" },
        { label: @tr("Chiedi un testo"), token: @tr("{{ask:Cosa cerchi?}}") },
        { label: @tr("Data di oggi"), token: "{date}" },
        { label: @tr("Ora"), token: "{time}" },
        { label: @tr("Risultato del comando precedente"), token: "{result}" },
        { label: @tr("App in primo piano"), token: "{app}" },
        { label: @tr("Titolo della finestra"), token: "{title}" },
    ];

    width: chip.preferred-width;
    height: 22px;
    accessible-role: button;
    accessible-label: @tr("Inserisci un segnaposto");
    accessible-action-default => { popup.show(); }

    chip := Rectangle {
        preferred-width: label.preferred-width + 34px;
        border-radius: 11px;
        background: touch.pressed ? Theme.press : touch.has-hover ? Theme.hover : transparent;
        border-width: 1px;
        border-color: touch.has-hover ? Theme.accent-line : Theme.line-strong;
        animate background, border-color { duration: Theme.quick; }
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 4px;
            Text {
                text: "{ }";
                font-size: 12px;
                font-weight: 700;
                vertical-alignment: center;
                color: Theme.accent;
            }
            label := Text {
                text: @tr("Segnaposto");
                font-size: 12px;
                vertical-alignment: center;
                color: Theme.soft;
            }
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { popup.show(); }
        }
    }
    popup := PopupWindow {
        x: root.width - 320px;
        y: root.height + 6px;
        width: 320px;
        Rectangle {
            border-radius: 12px;
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.card-border;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000088;
            VerticalLayout {
                padding: 6px;
                for item in root.items: Rectangle {
                    height: 44px;
                    border-radius: 8px;
                    background: row.has-hover ? Theme.hover : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;
                        Text {
                            horizontal-stretch: 1;
                            text: item.label;
                            font-size: 13px;
                            overflow: elide;
                            vertical-alignment: center;
                            color: Theme.text;
                        }
                        Text {
                            text: item.token;
                            font-size: 12px;
                            font-family: "Consolas";
                            vertical-alignment: center;
                            color: Theme.accent;
                        }
                    }
                    row := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.insert(item.token);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

// Un campo con l'etichetta sopra. Etichetta + campo = 56 px, come IconBox accanto.
// Con `tokens` accanto all'etichetta c'è il menu dei segnaposto.
component Field inherits VerticalLayout {
    in property <string> label;
    in property <bool> tokens;
    callback insert(string);
    spacing: 6px;
    HorizontalLayout {
        spacing: 8px;
        Text {
            horizontal-stretch: 1;
            text: root.label;
            font-size: 13px;
            font-weight: 600;
            height: 18px;
            vertical-alignment: center;
            overflow: elide;
            color: Theme.soft;
        }
        if root.tokens: VerticalLayout {
            alignment: center;
            PlaceholderMenu {
                insert(token) => { root.insert(token); }
            }
        }
    }
    @children
}

// ── Controlli ────────────────────────────────────────────────────────────────

// Anello di focus: compare solo quando ci si arriva con la tastiera (Tab).
// Si allarga di 3 px attorno all'elemento `around`.
component FocusRing inherits Rectangle {
    in property <length> around-width;
    in property <length> around-height;
    x: -3px;
    y: -3px;
    width: self.around-width + 6px;
    height: self.around-height + 6px;
    border-width: 2px;
    border-color: Theme.accent;
}

// Pulsante a pillola, alto come i campi. Con la tastiera: Tab per arrivarci, Invio o Spazio per premerlo.
component Btn {
    in property <string> text;
    in property <string> glyph;
    in property <Tone> tone: Tone.plain;
    in property <bool> enabled: true;
    callback clicked;

    property <bool> hot: touch.has-hover && root.enabled;
    property <bool> down: touch.pressed && root.enabled;
    property <bool> filled: root.tone == Tone.primary || root.tone == Tone.destructive;
    property <brush> ink: root.tone == Tone.primary ? Theme.on-accent
        : root.tone == Tone.destructive ? Theme.on-danger
        : root.tone == Tone.danger ? Theme.danger : Theme.text;

    // Disattivato, sfondo e testo sbiadiscono ciascuno per conto suo: con un'unica `opacity` sul
    // pulsante intero il testo scuro dei pulsanti pieni resterebbe ben leggibile, quasi attivo.
    property <float> fade: root.enabled ? 1 : 0.38;
    animate fade { duration: Theme.quick; }

    height: Theme.control;
    horizontal-stretch: 0;
    forward-focus: keys;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled { root.clicked(); }
    }

    Rectangle {
        opacity: root.fade;
        border-radius: self.height / 2;
        background: root.tone == Tone.primary ? (root.down ? Theme.accent-press : root.hot ? Theme.accent-hover : Theme.accent)
            : root.tone == Tone.destructive ? (root.hot ? Theme.danger-hover : Theme.danger)
            : root.down ? Theme.press : root.hot ? Theme.hover : transparent;
        border-width: root.filled ? 0px : 1px;
        border-color: root.tone == Tone.danger ? Theme.danger-line : root.hot ? Theme.accent-line : Theme.line-strong;
        animate background, border-color { duration: Theme.quick; }
    }
    if keys.has-focus: FocusRing {
        around-width: root.width;
        around-height: root.height;
        border-radius: self.height / 2;
    }
    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: root.glyph != "" ? 14px : 18px;
        padding-right: 18px;
        spacing: 8px;
        alignment: center;
        if root.glyph != "": Glyph {
            opacity: root.fade;
            text: root.glyph;
            font-size: 14px;
            color: root.ink;
        }
        Text {
            opacity: root.fade;
            text: root.text;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            color: root.ink;
        }
    }
}

// Pulsante quadrato con la sola icona, per le azioni dentro una riga.
component IconBtn {
    in property <string> glyph;
    in property <string> label;  // letto dagli screen reader
    in property <bool> enabled: true;
    in property <bool> danger;
    callback clicked;

    width: Theme.control;
    height: Theme.control;
    opacity: root.enabled ? 1 : 0.3;
    forward-focus: keys;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled { root.clicked(); }
    }

    Rectangle {
        border-radius: 8px;
        background: touch.pressed && root.enabled ? Theme.press : touch.has-hover && root.enabled ? Theme.hover : transparent;
        animate background { duration: Theme.quick; }
    }
    if keys.has-focus: FocusRing {
        around-width: root.width;
        around-height: root.height;
        border-radius: 10px;
    }
    Glyph {
        text: root.glyph;
        font-size: 15px;
        color: root.danger && touch.has-hover ? Theme.danger : Theme.soft;
    }
    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Interruttore acceso/spento, con l'etichetta a destra (facoltativa).
component Toggle {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled;

    function flip() {
        root.checked = !root.checked;
        root.toggled();
    }

    height: Theme.control;
    forward-focus: keys;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.flip(); }

    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 44px;
                height: 24px;
                border-radius: 12px;
                background: root.checked ? Theme.accent : Theme.press;
                border-width: root.checked ? 0px : 1px;
                border-color: Theme.line-strong;
                animate background { duration: Theme.smooth; }
                Rectangle {
                    x: root.checked ? 23px : 3px;
                    y: 3px;
                    width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: root.checked ? Theme.on-accent : Theme.soft;
                    animate x { duration: Theme.smooth; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                    animate background { duration: Theme.smooth; }
                }
                if keys.has-focus: FocusRing {
                    around-width: 44px;
                    around-height: 24px;
                    border-radius: self.height / 2;
                }
            }
        }
        if root.text != "": Text {
            text: root.text;
            font-size: 14px;
            vertical-alignment: center;
            color: Theme.text;
        }
    }
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.flip();
                return accept;
            }
            return reject;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.flip(); }
    }
}

// Scelta tra poche opzioni, tutte visibili: la selezione scivola sotto quella scelta.
// Frecce sinistra/destra per cambiarla da tastiera.
component Segmented {
    in property <[string]> labels;
    in property <[string]> glyphs;  // facoltative, una per opzione; spariscono se lo spazio è poco
    in-out property <int> current;
    callback selected(int);

    property <length> cell: (self.width - 8px) / max(1, self.labels.length);
    function choose(index: int) {
        if index >= 0 && index < root.labels.length && index != root.current {
            root.current = index;
            root.selected(index);
        }
    }

    height: 40px;
    min-width: self.labels.length * 72px;
    forward-focus: keys;
    accessible-role: tab-list;

    Rectangle {
        border-radius: 12px;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.card-border;
    }
    Rectangle {
        x: 4px + root.current * root.cell;
        y: 4px;
        width: root.cell;
        height: root.height - 8px;
        border-radius: 9px;
        background: Theme.accent-soft;
        border-width: 1px;
        border-color: Theme.accent-line;
        animate x { duration: Theme.smooth; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    }
    for label[i] in root.labels: Rectangle {
        x: 4px + i * root.cell;
        y: 4px;
        width: root.cell;
        height: root.height - 8px;
        accessible-role: tab;
        accessible-label: label;
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            if root.glyphs[i] != "" && root.cell >= 100px: Glyph {
                text: root.glyphs[i];
                font-size: 15px;
                color: i == root.current ? Theme.accent : Theme.soft;
            }
            Text {
                text: label;
                font-size: 14px;
                font-weight: i == root.current ? 600 : 400;
                vertical-alignment: center;
                color: i == root.current ? Theme.heading : Theme.text;
            }
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.choose(i); }
        }
    }
    if keys.has-focus: FocusRing {
        around-width: root.width;
        around-height: root.height;
        border-radius: 14px;
    }
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.LeftArrow {
                root.choose(root.current - 1);
                return accept;
            }
            if event.text == Key.RightArrow {
                root.choose(root.current + 1);
                return accept;
            }
            return reject;
        }
    }
}

// Un tasto disegnato, es. "Ctrl". `lit`: acceso, mentre lo si sta premendo.
component KeyCap inherits Rectangle {
    in property <string> text;
    in property <bool> lit;
    width: max(24px, label.preferred-width + 14px);
    height: 24px;
    border-radius: 6px;
    background: root.lit ? Theme.accent-soft : Theme.press;
    border-width: 1px;
    border-color: root.lit ? Theme.accent-line : Theme.line-strong;
    // Bordo inferiore più marcato: sembra un tasto vero.
    Rectangle {
        x: 1px;
        y: parent.height - 3px;
        width: parent.width - 2px;
        height: 2px;
        border-radius: 1px;
        background: root.lit ? Theme.accent-line : Theme.line-strong;
    }
    label := Text {
        x: 0px;
        y: 3px;
        width: parent.width;
        height: parent.height - 7px;
        text: root.text;
        horizontal-alignment: center;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
        color: root.lit ? Theme.heading : Theme.text;
    }
}

// Campo che registra una combinazione di tasti: un clic (o Invio) e si premono i tasti; 2 secondi
// dopo averli rilasciati la combinazione è quella scelta. L'ascolto vero lo fa Rust
// (settings/capture.rs), che aggiorna `pressed` e `confirming` mentre si compone.
component KeyField {
    in property <[string]> caps;  // la combinazione attuale, un tasto per voce
    in property <[string]> pressed;  // i tasti premuti finora mentre ascolta
    in property <bool> confirming;  // tutto rilasciato: la barra si riempie in 2 secondi
    in property <bool> listening;
    in property <string> empty-text: @tr("Nessuna");
    callback clicked();

    height: Theme.control;
    min-width: 220px;
    forward-focus: keys;
    accessible-role: button;
    accessible-label: root.listening ? @tr("In ascolto: premi la combinazione di tasti e rilasciala, dopo 2 secondi è quella scelta. Esc per annullare") : @tr("Combinazione di tasti: premi Invio per cambiarla");
    accessible-action-default => { root.clicked(); }

    Rectangle {
        border-radius: 8px;
        background: root.listening ? Theme.accent-soft : touch.has-hover ? Theme.hover : Theme.card;
        border-width: 1px;
        border-color: root.listening ? Theme.accent : touch.has-hover ? Theme.line-strong : Theme.card-border;
        animate background, border-color { duration: Theme.quick; }
    }
    if keys.has-focus && !root.listening: FocusRing {
        around-width: root.width;
        around-height: root.height;
        border-radius: 10px;
    }
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 12px;
        spacing: 4px;
        if !root.listening: HorizontalLayout {
            spacing: 4px;
            for cap in root.caps: VerticalLayout {
                alignment: center;
                KeyCap { text: cap; }
            }
        }
        if !root.listening && root.caps.length == 0: Text {
            text: root.empty-text;
            font-size: 14px;
            vertical-alignment: center;
            color: Theme.faint;
        }
        if root.listening: HorizontalLayout {
            spacing: 4px;
            for cap in root.pressed: VerticalLayout {
                alignment: center;
                KeyCap {
                    text: cap;
                    lit: true;
                }
            }
        }
        // Finché si tiene premuto qualcosa si possono aggiungere altri tasti.
        if root.listening && !root.confirming: Text {
            text: root.pressed.length == 0 ? @tr("Premi i tasti…") : "+ …";
            font-size: 14px;
            vertical-alignment: center;
            color: Theme.accent;
        }
        Rectangle { horizontal-stretch: 1; }
        // In ascolto: un puntino che pulsa, come una registrazione. Altrimenti, l'icona della tastiera.
        if root.listening: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.accent;
                opacity: 0.35 + 0.65 * abs(sin(animation-tick() / 1ms * 0.18deg));
            }
        }
        if !root.listening: Glyph {
            text: "\u{E765}";
            font-size: 15px;
            color: touch.has-hover ? Theme.soft : Theme.faint;
        }
    }
    // Tutto rilasciato: la barra si riempie nei 2 secondi dopo i quali la combinazione è quella
    // scelta (capture::QUIET). Premendo di nuovo torna subito vuota.
    bar := Rectangle {
        x: 10px;
        y: root.height - 3px;
        width: 0px;
        height: 2px;
        border-radius: 1px;
        background: Theme.accent;
    }
    states [
        confirming when root.listening && root.confirming: {
            bar.width: root.width - 20px;
            in {
                animate bar.width { duration: 2s; easing: linear; }
            }
        }
    ]
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Cursore per scegliere un valore in un intervallo. Frecce (o Pag su/giù) per cambiarlo da tastiera.
component ValueSlider {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <string> label;  // letto dagli screen reader
    in-out property <float> value;
    callback changed(float);

    property <length> thumb: 18px;
    property <float> ratio: (root.value - root.minimum) / max(1, root.maximum - root.minimum);
    function set(v: float) {
        if clamp(round(v / root.step) * root.step, root.minimum, root.maximum) != root.value {
            root.value = clamp(round(v / root.step) * root.step, root.minimum, root.maximum);
            root.changed(root.value);
        }
    }
    function set-at(x: length) {
        root.set(root.minimum + (x - root.thumb / 2) / max(1px, root.width - root.thumb) * (root.maximum - root.minimum));
    }

    height: Theme.control;
    min-width: 160px;
    forward-focus: keys;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: "\{round(root.value)}";
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-action-increment => { root.set(root.value + root.step); }
    accessible-action-decrement => { root.set(root.value - root.step); }

    // Binario, con la parte già percorsa del colore di accento.
    Rectangle {
        x: root.thumb / 2;
        y: (root.height - 4px) / 2;
        width: root.width - root.thumb;
        height: 4px;
        border-radius: 2px;
        background: Theme.press;
    }
    Rectangle {
        x: root.thumb / 2;
        y: (root.height - 4px) / 2;
        width: root.ratio * (root.width - root.thumb);
        height: 4px;
        border-radius: 2px;
        background: Theme.accent;
    }
    if keys.has-focus: FocusRing {
        x: root.ratio * (root.width - root.thumb) - 3px;
        y: (root.height - root.thumb) / 2 - 3px;
        around-width: root.thumb;
        around-height: root.thumb;
        border-radius: self.height / 2;
    }
    Rectangle {
        x: root.ratio * (root.width - root.thumb);
        y: (root.height - root.thumb) / 2;
        width: root.thumb;
        height: root.thumb;
        border-radius: root.thumb / 2;
        background: touch.pressed ? Theme.accent-press : touch.has-hover ? Theme.accent-hover : Theme.accent;
        drop-shadow-blur: 6px;
        drop-shadow-color: #00000066;
        animate background { duration: Theme.quick; }
        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: Theme.on-accent;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.set-at(self.mouse-x);
                keys.focus();
            }
        }
        moved => {
            if self.pressed { root.set-at(self.mouse-x); }
        }
    }
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.LeftArrow || event.text == Key.DownArrow {
                root.set(root.value - root.step);
                return accept;
            }
            if event.text == Key.RightArrow || event.text == Key.UpArrow {
                root.set(root.value + root.step);
                return accept;
            }
            if event.text == Key.PageDown || event.text == Key.Home {
                root.set(event.text == Key.Home ? root.minimum : root.value - 4 * root.step);
                return accept;
            }
            if event.text == Key.PageUp || event.text == Key.End {
                root.set(event.text == Key.End ? root.maximum : root.value + 4 * root.step);
                return accept;
            }
            return reject;
        }
    }
}

// Campioni di colore: quello scelto ha un anello e il segno di spunta. Frecce per cambiarlo.
component Swatches {
    in property <[AccentChoice]> choices;
    in-out property <int> current;
    callback selected(int);

    function choose(index: int) {
        if index >= 0 && index < root.choices.length && index != root.current {
            root.current = index;
            root.selected(index);
        }
    }

    height: 36px;
    forward-focus: keys;
    accessible-role: list;
    accessible-label: @tr("Colore");

    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        for choice[i] in root.choices: Rectangle {
            property <bool> chosen: i == root.current;
            width: 36px;
            height: 36px;
            accessible-role: button;
            accessible-label: choice.name;
            accessible-checkable: true;
            accessible-checked: self.chosen;
            accessible-action-default => { root.choose(i); }
            // Anello del colore attorno a quello scelto, alone sotto il mouse.
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 18px;
                border-width: parent.chosen ? 2px : 0px;
                border-color: choice.color;
                background: touch.has-hover && !parent.chosen ? choice.color.with-alpha(0.18) : transparent;
                animate background { duration: Theme.quick; }
            }
            Rectangle {
                width: parent.chosen ? 24px : 28px;
                height: self.width;
                border-radius: self.width / 2;
                background: choice.color;
                animate width { duration: Theme.smooth; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                if parent.chosen: Glyph {
                    text: "\u{E73E}";
                    font-size: 12px;
                    font-weight: 700;
                    color: #06191B;
                }
            }
            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.choose(i); }
            }
        }
    }
    if keys.has-focus: FocusRing {
        x: root.current * 44px - 3px;
        around-width: 36px;
        around-height: 36px;
        border-radius: 21px;
    }
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.LeftArrow {
                root.choose(root.current - 1);
                return accept;
            }
            if event.text == Key.RightArrow {
                root.choose(root.current + 1);
                return accept;
            }
            return reject;
        }
    }
}

// Una riga cliccabile: icona, testo e (facoltativo) dettaglio.
component Row inherits Rectangle {
    in property <string> glyph;
    in property <string> text;
    in property <string> detail;
    in property <bool> selected;
    in property <bool> action;  // una voce che fa qualcosa ("Nuova ruota"): testo colorato
    callback clicked;

    height: root.detail == "" ? 44px : 56px;
    border-radius: 10px;
    background: root.selected ? Theme.accent-soft : touch.pressed ? Theme.press : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.quick; }
    accessible-role: list-item;
    accessible-label: root.text;

    // Trattino dell'accento a sinistra della riga selezionata: cresce dal centro.
    Rectangle {
        x: 0px;
        width: 3px;
        height: root.selected ? 22px : 0px;
        y: (root.height - self.height) / 2;
        border-radius: 1.5px;
        background: Theme.accent;
        animate height { duration: Theme.smooth; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 12px;
        Glyph {
            width: 20px;
            text: root.glyph;
            font-size: 18px;
            color: root.selected || root.action ? Theme.accent : Theme.soft;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.text;
                font-size: 14px;
                font-weight: root.selected || root.action ? 600 : 400;
                overflow: elide;
                color: root.action ? Theme.accent : root.selected ? Theme.heading : Theme.text;
            }
            if root.detail != "": Text {
                text: root.detail;
                font-size: 12px;
                overflow: elide;
                color: root.selected ? Theme.soft : Theme.faint;
            }
        }
    }
}

// Scelte con icona in una griglia che va a capo quando lo spazio non basta; quella scelta
// (`current`) è accesa. Con `current: -1` sono semplici pulsanti.
component OptionGrid {
    in property <[Choice]> choices;
    in-out property <int> current: -1;
    in property <length> cell: 170px;  // larghezza minima di una casella
    callback selected(int);

    property <int> columns: max(1, min(self.choices.length, floor((self.width + 8px) / (self.cell + 8px))));
    property <length> column-width: (self.width - (self.columns - 1) * 8px) / self.columns;
    height: ceil(self.choices.length / self.columns) * 44px - 8px;
    accessible-role: list;

    for choice[i] in root.choices: tile := Rectangle {
        property <bool> chosen: i == root.current;
        x: mod(i, root.columns) * (root.column-width + 8px);
        y: floor(i / root.columns) * 44px;
        width: root.column-width;
        height: 36px;
        border-radius: 10px;
        background: self.chosen ? Theme.accent-soft : touch.pressed ? Theme.press : touch.has-hover ? Theme.hover : transparent;
        border-width: 1px;
        border-color: self.chosen ? Theme.accent-line : touch.has-hover ? Theme.accent-line : Theme.line-strong;
        animate background, border-color { duration: Theme.quick; }
        accessible-role: button;
        accessible-label: choice.label;
        accessible-checkable: root.current >= 0;
        accessible-checked: self.chosen;
        accessible-action-default => {
            root.current = i;
            root.selected(i);
        }
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 10px;
            spacing: 10px;
            Glyph {
                width: 18px;
                text: choice.glyph;
                font-size: 15px;
                color: tile.chosen ? Theme.accent : Theme.soft;
            }
            Text {
                text: choice.label;
                font-size: 13px;
                font-weight: tile.chosen ? 600 : 400;
                overflow: elide;
                vertical-alignment: center;
                color: tile.chosen ? Theme.heading : Theme.text;
            }
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.current = i;
                root.selected(i);
            }
        }
    }
}

// Scelte più grandi, con una riga di spiegazione: nelle finestre "Aggiungi un passo" e "Nuova azione".
component ChoiceTiles {
    in property <[Choice]> choices;
    in property <int> columns: 2;
    callback picked(int);

    property <length> column-width: (self.width - (self.columns - 1) * 8px) / self.columns;
    height: ceil(self.choices.length / self.columns) * 66px - 8px;
    accessible-role: list;

    for choice[i] in root.choices: Rectangle {
        x: mod(i, root.columns) * (root.column-width + 8px);
        y: floor(i / root.columns) * 66px;
        width: root.column-width;
        height: 58px;
        border-radius: 12px;
        background: touch.pressed ? Theme.press : touch.has-hover ? Theme.hover : Theme.card;
        border-width: 1px;
        border-color: touch.has-hover ? Theme.accent-line : Theme.card-border;
        animate background, border-color { duration: Theme.quick; }
        accessible-role: button;
        accessible-label: choice.label;
        accessible-description: choice.hint;
        accessible-action-default => { root.picked(i); }
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 12px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 16px;
                    background: Theme.accent-soft;
                    Glyph {
                        text: choice.glyph;
                        font-size: 15px;
                        color: Theme.accent;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: choice.label;
                    font-size: 14px;
                    font-weight: 600;
                    overflow: elide;
                    color: Theme.heading;
                }
                Text {
                    text: choice.hint;
                    font-size: 12px;
                    overflow: elide;
                    color: Theme.body;
                }
            }
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.picked(i); }
        }
    }
}

// Ciò che si sta trascinando, sotto il cursore: una pallina come quelle della ruota e il nome.
// Rossa quando, rilasciando, l'elemento viene tolto.
component Ghost {
    x: Drag.x - 22px;
    y: Drag.y - 22px;
    width: 52px + name.width;
    height: 44px;
    Rectangle {
        x: 0px;
        y: 0px;
        width: 44px;
        height: 44px;
        border-radius: 22px;
        background: Drag.removing ? Theme.danger : Theme.accent;
        drop-shadow-blur: 14px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #0000009A;
        animate background { duration: Theme.quick; }
        if Drag.glyph != "": Glyph {
            text: Drag.glyph;
            font-size: 18px;
            color: Drag.removing ? Theme.on-danger : Theme.on-accent;
        }
        if Drag.glyph == "": Text {
            text: Drag.initial;
            font-size: 16px;
            font-weight: 600;
            color: Drag.removing ? Theme.on-danger : Theme.on-accent;
        }
    }
    name := Rectangle {
        x: 52px;
        y: 10px;
        width: label.preferred-width + 20px;
        height: 24px;
        border-radius: 12px;
        background: Theme.raised;
        border-width: 1px;
        border-color: Drag.removing ? Theme.danger-line : Theme.card-border;
        label := Text {
            text: Drag.removing ? @tr("Rilascia per togliere") : Drag.label;
            font-size: 12px;
            font-weight: 600;
            color: Drag.removing ? Theme.danger : Theme.heading;
        }
    }
}

// Il riquadro dell'icona: cliccandolo si apre il selettore. Alto come un campo con l'etichetta.
component IconBox inherits Rectangle {
    in property <string> glyph;
    in property <bool> active;
    callback clicked;
    width: 56px;
    height: 56px;
    border-radius: Theme.radius;
    background: root.active ? Theme.accent-soft : touch.has-hover ? Theme.hover : Theme.card;
    border-width: 1px;
    border-color: root.active ? Theme.accent : touch.has-hover ? Theme.line-strong : Theme.card-border;
    animate background, border-color { duration: Theme.quick; }
    accessible-role: button;
    accessible-label: @tr("Scegli l'icona");
    accessible-action-default => { root.clicked(); }
    Glyph {
        text: root.glyph;
        font-size: 24px;
        color: root.active ? Theme.accent : Theme.heading;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component IconPicker inherits Rectangle {
    in property <[IconData]> icons;
    in property <string> current;
    in-out property <string> search;
    callback search-changed(string);
    callback picked(string);

    property <length> cell: 48px;
    property <int> columns: max(1, floor((self.width - 32px) / self.cell));
    property <string> hovered;

    height: 360px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.card-border;
    background: Theme.card;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        LineEdit {
            placeholder-text: @tr("Cerca un'icona (es. cartella, mail, play, E8B7)…");
            text <=> root.search;
            edited(text) => {
                root.hovered = "";
                root.search-changed(text);
            }
        }
        ScrollView {
            content-width: root.columns * root.cell;
            content-height: ceil(root.icons.length / root.columns) * root.cell;
            for icon[i] in root.icons: Rectangle {
                property <bool> chosen: icon.code == root.current;
                x: mod(i, root.columns) * root.cell;
                y: floor(i / root.columns) * root.cell;
                width: root.cell - 4px;
                height: root.cell - 4px;
                border-radius: 10px;
                background: self.chosen ? Theme.accent-soft : touch.has-hover ? Theme.hover : transparent;
                border-width: self.chosen ? 1px : 0px;
                border-color: Theme.accent-line;
                animate background { duration: Theme.quick; }
                Glyph {
                    text: icon.glyph;
                    font-size: 22px;
                    color: parent.chosen ? Theme.accent : Theme.text;
                }
                touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.picked(icon.code); }
                    changed has-hover => {
                        if self.has-hover { root.hovered = icon.name + "  (" + icon.code + ")"; }
                    }
                }
            }
        }
        Hint {
            text: root.icons.length == 0 ? @tr("Nessuna icona trovata.") : root.hovered != "" ? root.hovered : @tr("Passa sopra un'icona per vederne il nome.");
            wrap: no-wrap;
        }
    }
}

// Il nome di una ruota o di un'azione, scritto direttamente nel titolo della pagina. Sembra un
// titolo; passandoci sopra si accende, la matita subito dopo il testo dice che si può cambiare,
// un clic lo modifica. Invio o Esc tolgono il focus. Largo quanto il testo (cresce mentre si
// scrive); lo sfondo sporge di 10 px a sinistra, così il testo resta allineato con la riga sotto.
component TitleField {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <string> label;  // letto dagli screen reader
    callback edited(string);

    height: 44px;
    min-width: 120px;
    preferred-width: (root.text == "" ? placeholder.preferred-width : input.preferred-width) + 46px;
    forward-focus: input;

    touch := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
        Rectangle {
            x: -10px;
            width: parent.width + 10px;
            border-radius: 10px;
            background: input.has-focus ? Theme.card : touch.has-hover ? Theme.hover : transparent;
            border-width: 1px;
            border-color: input.has-focus ? Theme.accent : transparent;
            animate background, border-color { duration: Theme.quick; }
        }
        ContextMenuArea {
            x: 0px;
            width: parent.width - 36px;
            height: parent.height;
            Menu {
                MenuItem {
                    title: @tr("Taglia");
                    activated => { input.cut(); }
                }
                MenuItem {
                    title: @tr("Copia");
                    activated => { input.copy(); }
                }
                MenuItem {
                    title: @tr("Incolla");
                    activated => { input.paste(); }
                }
                MenuItem {
                    title: @tr("Seleziona tutto");
                    activated => { input.select-all(); }
                }
            }
            Rectangle {
                clip: true;
                placeholder := Text {
                    x: 0px;
                    width: parent.width;
                    height: parent.height;
                    visible: root.text == "" && input.preedit-text == "";
                    text: root.placeholder;
                    font-size: 26px;
                    font-weight: 600;
                    letter-spacing: -0.4px;
                    vertical-alignment: center;
                    overflow: elide;
                    color: Theme.faint;
                    accessible-role: none;
                }
                // Scorre per tenere in vista il cursore, come i campi standard (LineEdit).
                input := TextInput {
                    property <length> computed-x;
                    x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
                    width: max(parent.width - self.text-cursor-width, self.preferred-width);
                    height: parent.height;
                    single-line: true;
                    font-size: 26px;
                    font-weight: 600;
                    letter-spacing: -0.4px;
                    vertical-alignment: center;
                    color: Theme.heading;
                    selection-background-color: Theme.accent.with-alpha(0.35);
                    selection-foreground-color: Theme.heading;
                    accessible-label: root.label;
                    cursor-position-changed(position) => {
                        if position.x + self.computed-x < 0px {
                            self.computed-x = -position.x;
                        } else if position.x + self.computed-x > parent.width - self.text-cursor-width {
                            self.computed-x = parent.width - position.x - self.text-cursor-width;
                        }
                    }
                    edited => { root.edited(self.text); }
                    accepted => { self.clear-focus(); }
                    key-pressed(event) => {
                        if event.text == Key.Escape {
                            self.clear-focus();
                            return accept;
                        }
                        return reject;
                    }
                }
            }
        }
        Glyph {
            x: parent.width - 30px;
            width: 24px;
            height: parent.height;
            text: "\u{E70F}";
            font-size: 15px;
            color: touch.has-hover ? Theme.soft : Theme.faint;
            opacity: input.has-focus ? 0 : 1;
            animate opacity { duration: Theme.quick; }
            accessible-role: none;
        }
    }
}

// Intestazione di una ruota o di un'azione: l'icona (un clic apre il selettore qui sotto) e il
// nome, modificabile nel titolo stesso; sotto, una riga su dove si usa.
// La riga sotto non è facoltativa (niente `if`): vedi la nota sui testi a capo in `Page`.
component NameHeader inherits HorizontalLayout {
    in property <string> glyph;
    in property <bool> picking;  // il selettore delle icone è aperto
    in-out property <string> name;
    in property <string> placeholder;
    in property <string> name-label;
    in property <string> subtitle;
    callback icon-clicked();
    callback edited(string);

    spacing: 20px;
    VerticalLayout {
        alignment: center;
        IconBox {
            glyph: root.glyph;
            active: root.picking;
            clicked => { root.icon-clicked(); }
        }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        HorizontalLayout {
            alignment: start;
            TitleField {
                text <=> root.name;
                placeholder: root.placeholder;
                label: root.name-label;
                edited(text) => { root.edited(text); }
            }
        }
        Text {
            text: root.subtitle;
            font-size: 14px;
            wrap: word-wrap;
            color: Theme.body;
        }
    }
}

// ── Struttura delle pagine ───────────────────────────────────────────────────

// Una pagina: colonna scorrevole con margini fissi e larghezza massima, allineata a sinistra.
//
// Testi che vanno a capo: dentro un layout facoltativo (`if …: VerticalLayout { … Text … }`,
// anche un componente che eredita da un layout, come `Section` o `SettingRow`) Slint li misura
// su una riga sola, e ciò che segue ci finisce sopra. Un testo facoltativo va messo direttamente
// nel layout (`if …: Text`); dentro un blocco facoltativo, solo testi brevi, su una riga.
component Page inherits ScrollView {
    HorizontalLayout {
        alignment: start;
        // Larga quanto si può, fino a 1000 px, qualunque sia il contenuto.
        VerticalLayout {
            max-width: 1000px;
            preferred-width: 1000px;
            horizontal-stretch: 1;
            padding-left: Theme.margin;
            padding-right: Theme.margin;
            // Sopra c'è già la barra del titolo.
            padding-top: 4px;
            padding-bottom: 40px;
            spacing: Theme.margin;
            alignment: start;
            @children
        }
    }
}

// Titolo della pagina con una riga di spiegazione; a destra i pulsanti (figli).
component PageHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 16px;
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 6px;
        alignment: start;
        Text {
            text: root.title;
            font-size: 26px;
            font-weight: 600;
            letter-spacing: -0.4px;
            overflow: elide;
            color: Theme.heading;
        }
        if root.subtitle != "": Text {
            text: root.subtitle;
            font-size: 14px;
            wrap: word-wrap;
            color: Theme.body;
        }
    }
    VerticalLayout {
        alignment: start;
        padding-top: 2px;
        HorizontalLayout {
            spacing: 8px;
            @children
        }
    }
}

// Una sezione della pagina: titolo, spiegazione facoltativa e contenuto.
component Section inherits VerticalLayout {
    in property <string> title;
    in property <string> description;
    in property <string> aside;  // pastiglia accanto al titolo, es. "3 di 8"
    spacing: 14px;
    VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Text {
                text: root.title;
                font-size: 17px;
                font-weight: 600;
                vertical-alignment: center;
                color: Theme.heading;
            }
            if root.aside != "": VerticalLayout {
                alignment: center;
                Chip { text: root.aside; }
            }
        }
        if root.description != "": Hint { text: root.description; }
    }
    @children
}

// Una riga di impostazione: titolo e spiegazione a sinistra, il controllo (figlio) a destra.
component SettingRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 16px;
    padding-bottom: 16px;
    spacing: 24px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 4px;
        Text {
            text: root.title;
            font-size: 14px;
            font-weight: 600;
            color: Theme.heading;
        }
        if root.description != "": Hint { text: root.description; }
    }
    VerticalLayout {
        alignment: center;
        @children
    }
}

// ── Ruota ────────────────────────────────────────────────────────────────────

// Anteprima della ruota, con le stesse misure di quella vera (overlay.rs): disco 152,
// orbita 96, palline 21, mozzo 36, anello della zona morta 41 (overlay::DEAD_ZONE). `zoom` la
// ingrandisce.
//
// È anche il modo di modificarla: clic su una pallina per sceglierla, doppio clic per
// modificarla, tasto destro per il suo menu; trascinandola la si sposta (o, fuori dal disco, la si
// toglie). Finché c'è posto, dopo l'ultima pallina c'è il «+», che aggiunge un elemento: con il
// «+» le palline hanno un posto in più che sulla ruota vera, dove non c'è.
component WheelPreview inherits Rectangle {
    in property <[SlotRow]> slots;
    in property <int> current: -1;
    in property <string> title;  // testo nel mozzo; vuoto = stella del logo
    in property <float> zoom: 1;
    in property <bool> addable;  // c'è posto: mostra il «+»
    // La pallina che si sta spostando (la calcola `WheelEditor`): la porta il cursore e le altre
    // le fanno posto in `drop-at`. `removing`: è fuori dal disco, rilasciandola verrà tolta.
    in property <int> lift: -1;
    in property <int> drop-at: -1;
    in property <bool> removing;
    in property <string> ghost-glyph;  // la pallina spostata, per il segnaposto
    in property <string> ghost-initial;
    in property <string> ghost-label;
    callback select(int);
    callback edit(int);
    callback add();
    callback menu(int, length, length);  // tasto destro: la pallina (`count` è il «+», meno di 0 nessuna) e il punto
    callback drag-start(int);
    callback drag-end(bool);  // true: annullato
    callback key-select(int);  // frecce: elemento precedente (-1) o successivo (1)
    callback key-move(int);  // Ctrl + frecce: sposta l'elemento scelto
    callback key-remove();
    callback key-edit();

    property <length> u: 1px * root.zoom;  // un'unità della ruota vera
    property <int> count: self.slots.length;
    property <int> extra: self.addable ? 1 : 0;  // il posto del «+»
    property <bool> dragging: self.lift >= 0;
    // Posti sulla ruota: uno in meno mentre si toglie una pallina, uno in più per il «+».
    property <int> shown: (self.dragging && self.removing ? self.count - 1 : self.count) + self.extra;
    property <angle> step: 360deg / max(1, self.shown);
    property <float> c: 152;  // centro
    property <float> orbit: 96;
    property <float> ball: 21;
    property <float> ring: 41;
    // La pallina sotto il cursore (`count` è il «+»).
    property <int> hovered: touch.has-hover && !self.dragging ? self.hit(touch.mouse-x, touch.mouse-y, self.count + self.extra) : -1;
    // Subito dopo aver rilasciato, i dati cambiano già nell'ordine nuovo: le palline devono
    // restare dove sono, senza animazione (vedi `settle`).
    property <bool> snap;

    // Il posto occupato dall'elemento `i` (che ha posto `i` quando non si trascina niente).
    // Il «+» (`i` = `count`) è sempre l'ultimo.
    pure function visual(i: int) -> int {
        if i >= root.count {
            return root.shown - 1;
        }
        if root.lift < 0 {
            return i;
        }
        if i == root.lift {
            return root.removing ? 0 : root.drop-at;
        }
        let j = i > root.lift ? i - 1 : i;
        if root.removing {
            return j;
        }
        return j >= root.drop-at ? j + 1 : j;
    }

    // Lo spicchio sotto il punto (x, y) con `n` posti, come `overlay::slice_at` nella ruota vera.
    // -1 fuori dal disco, -2 nel mozzo (la zona morta).
    pure public function hit(x: length, y: length, n: int) -> int {
        if sqrt(pow(x / root.u - root.c, 2) + pow(y / root.u - root.c, 2)) > root.c {
            return -1;
        }
        if n <= 0 || sqrt(pow(x / root.u - root.c, 2) + pow(y / root.u - root.c, 2)) < root.ring {
            return -2;
        }
        return mod(floor(mod(atan2(y / root.u - root.c, x / root.u - root.c) / 1deg + 90 + 180 / n + 720, 360) / (360 / n)), n);
    }

    // Il centro della pallina `i`: lì si apre il suo menu quando lo si chiede dalla tastiera.
    pure function center-x(i: int) -> length {
        return (root.c + root.orbit * cos(-90deg + root.visual(i) * root.step)) * root.u;
    }
    pure function center-y(i: int) -> length {
        return (root.c + root.orbit * sin(-90deg + root.visual(i) * root.step)) * root.u;
    }

    public function settle() {
        root.snap = true;
        settle-timer.running = true;
    }
    settle-timer := Timer {
        interval: 80ms;
        running: false;
        triggered => {
            root.snap = false;
            self.running = false;
        }
    }

    // L'arco di direzione segue lo spicchio selezionato girando dalla parte più corta:
    // a ogni cambio si aggiunge la differenza tra -180° e 180°, e l'animazione fa il resto.
    // Senza selezione resta fermo dov'era e sfuma.
    property <angle> direction: -90deg;
    function aim() {
        if root.current >= 0 {
            root.direction += (mod((-90deg + root.current * root.step - root.direction) / 1deg + 540, 360) - 180) * 1deg;
        }
    }
    changed current => { root.aim(); }
    changed step => { root.aim(); }
    animate direction { duration: 240ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

    width: 304 * root.u;
    height: 304 * root.u;
    forward-focus: keys;
    accessible-role: list;
    accessible-label: @tr("Elementi della ruota");

    // Disco, orbita e anello attorno al mozzo. Il disco si accende mentre si sposta una pallina,
    // e diventa rosso quando rilasciandola la si toglie.
    Rectangle {
        width: 304 * root.u;
        height: 304 * root.u;
        border-radius: 152 * root.u;
        background: Theme.disc;
        border-width: root.dragging && !root.removing ? 2px : 1px;
        border-color: root.removing ? Theme.danger-line : root.dragging ? Theme.accent-line : keys.has-focus ? Theme.line-strong : Theme.card-border;
        animate border-color { duration: Theme.quick; }
    }
    Rectangle {
        width: 192 * root.u;
        height: 192 * root.u;
        border-radius: 96 * root.u;
        border-width: 1px;
        border-color: Theme.line;
    }
    Rectangle {
        width: 82 * root.u;
        height: 82 * root.u;
        border-radius: 41 * root.u;
        border-width: 1px;
        border-color: Theme.line-strong;
    }

    // Arco di direzione sull'anello, verso lo spicchio selezionato.
    Path {
        property <angle> half: min(root.step * 0.3, 28deg);
        x: 0px;
        y: 0px;
        width: 304 * root.u;
        height: 304 * root.u;
        viewbox-width: 304;
        viewbox-height: 304;
        stroke: Theme.accent;
        stroke-width: 3 * root.u;
        stroke-line-cap: round;
        opacity: root.current >= 0 && root.count > 0 && !root.dragging ? 1 : 0;
        animate opacity { duration: Theme.smooth; }
        commands: "M \{root.c + root.ring * cos(root.direction - self.half)} \{root.c + root.ring * sin(root.direction - self.half)} "
            + "A \{root.ring} \{root.ring} 0 0 1 \{root.c + root.ring * cos(root.direction + self.half)} \{root.c + root.ring * sin(root.direction + self.half)}";
    }

    // Il posto dove finirà la pallina spostata: un anello acceso con l'icona sbiadita.
    if root.dragging && !root.removing: Rectangle {
        property <angle> a: -90deg + root.drop-at * root.step;
        animate a { duration: 200ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        x: (root.c + root.orbit * cos(self.a) - root.ball) * root.u;
        y: (root.c + root.orbit * sin(self.a) - root.ball) * root.u;
        width: 42 * root.u;
        height: 42 * root.u;
        border-radius: 21 * root.u;
        background: Theme.accent-soft;
        border-width: 2px;
        border-color: Theme.accent;
        if root.ghost-glyph != "": Glyph {
            text: root.ghost-glyph;
            font-size: 17 * root.u;
            color: Theme.accent;
        }
        if root.ghost-glyph == "": Text {
            text: root.ghost-initial;
            font-size: 15 * root.u;
            font-weight: 600;
            color: Theme.accent;
        }
    }

    // Il «+», dopo l'ultima pallina: aggiunge un elemento.
    if root.addable: Rectangle {
        property <bool> hot: root.hovered == root.count;
        property <float> nudge: self.hot ? 1.5 : 0;
        property <angle> a: -90deg + root.visual(root.count) * root.step;
        property <float> bx: root.c + (root.orbit + self.nudge) * cos(self.a);
        property <float> by: root.c + (root.orbit + self.nudge) * sin(self.a);
        animate nudge { duration: Theme.smooth; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        animate a { duration: root.snap ? 0ms : 260ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        x: 0px;
        y: 0px;
        width: 304 * root.u;
        height: 304 * root.u;
        opacity: root.dragging ? 0.35 : 1;
        animate opacity { duration: Theme.quick; }
        accessible-role: button;
        accessible-label: @tr("Aggiungi un elemento");
        accessible-action-default => { root.add(); }
        Rectangle {
            x: (parent.bx - root.ball) * root.u;
            y: (parent.by - root.ball) * root.u;
            width: 42 * root.u;
            height: 42 * root.u;
            border-radius: 21 * root.u;
            background: parent.hot ? Theme.accent-soft : transparent;
            border-width: 1.5px;
            border-color: parent.hot ? Theme.accent : Theme.accent-line;
            animate background, border-color { duration: Theme.quick; }
            Glyph {
                text: "\u{E710}";
                font-size: 16 * root.u;
                color: Theme.accent;
            }
        }
        Text {
            x: (parent.bx - 32) * root.u;
            y: (parent.by + root.ball + 3) * root.u;
            width: 64 * root.u;
            height: 16 * root.u;
            text: @tr("Aggiungi");
            font-size: 11.5 * root.u;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
            color: Theme.accent;
        }
    }

    // Le palline, con l'etichetta sotto. Quella selezionata si accende e si sporge un poco.
    for slot[i] in root.slots: Rectangle {
        property <bool> on: i == root.current && !root.dragging;
        property <bool> hot: i == root.hovered;
        property <float> nudge: self.on ? 3 : self.hot ? 1.5 : 0;
        property <angle> a: -90deg + root.visual(i) * root.step;
        property <float> bx: root.c + (root.orbit + self.nudge) * cos(self.a);
        property <float> by: root.c + (root.orbit + self.nudge) * sin(self.a);
        animate nudge { duration: Theme.smooth; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        animate a { duration: root.snap ? 0ms : 260ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        x: 0px;
        y: 0px;
        width: 304 * root.u;
        height: 304 * root.u;
        // La pallina trascinata la porta il cursore (`Ghost`): qui non si vede.
        opacity: i == root.lift ? 0 : 1;
        accessible-role: list-item;
        accessible-label: "\{i + 1}. \{slot.label}";
        accessible-item-selectable: true;
        accessible-item-selected: i == root.current;

        // Alone attorno alla pallina accesa.
        Rectangle {
            x: (parent.bx - 28) * root.u;
            y: (parent.by - 28) * root.u;
            width: 56 * root.u;
            height: 56 * root.u;
            border-radius: 28 * root.u;
            background: Theme.accent-soft;
            opacity: parent.on ? 1 : parent.hot ? 0.5 : 0;
            animate opacity { duration: Theme.smooth; }
        }
        Rectangle {
            x: (parent.bx - root.ball) * root.u;
            y: (parent.by - root.ball) * root.u;
            width: 42 * root.u;
            height: 42 * root.u;
            border-radius: 21 * root.u;
            background: parent.on ? Theme.accent : Theme.ball;
            animate background { duration: Theme.smooth; }
            if slot.glyph != "": Glyph {
                text: slot.glyph;
                font-size: 17 * root.u;
                color: Theme.on-ball;
            }
            if slot.glyph == "": Text {
                text: slot.initial;
                font-size: 15 * root.u;
                font-weight: 600;
                color: Theme.on-ball;
            }
            // Bollino del sottomenu.
            if slot.submenu: Rectangle {
                x: 29 * root.u;
                y: -2 * root.u;
                width: 15 * root.u;
                height: 15 * root.u;
                border-radius: 7.5 * root.u;
                background: Theme.disc;
                Text {
                    text: "›";
                    font-size: 13 * root.u;
                    font-weight: 700;
                    color: Theme.accent;
                }
            }
        }
        Text {
            x: (parent.bx - 32) * root.u;
            y: (parent.by + root.ball + 3) * root.u;
            width: 64 * root.u;
            height: 16 * root.u;
            text: slot.label;
            font-size: 11.5 * root.u;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
            color: parent.on ? Theme.heading : Theme.soft;
        }
    }

    // Mozzo: il nome dell'elemento selezionato o di quello trascinato, altrimenti stella o nome della ruota.
    Rectangle {
        property <string> label: root.removing ? @tr("Togli") : root.dragging ? root.ghost-label : root.current >= 0 && root.current < root.count ? root.slots[root.current].label : root.title;
        width: 72 * root.u;
        height: 72 * root.u;
        border-radius: 36 * root.u;
        background: Theme.bg;
        border-width: 1px;
        border-color: root.removing ? Theme.danger-line : Theme.line-strong;
        if self.label == "": Star {
            width: 26 * root.u;
            height: 32 * root.u;
        }
        if self.label != "": Text {
            width: 64 * root.u;
            text: parent.label;
            // Un nome lungo rimpicciolisce un poco: una parola sola troppo larga andrebbe a capo a metà.
            font-size: (self.text.character-count > 9 ? 10.5 : 12) * root.u;
            font-weight: 600;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
            color: root.removing ? Theme.danger : Theme.heading;
        }
    }

    // Clic: sceglie (sul «+», aggiunge); doppio clic: modifica; tasto destro: il menu;
    // pressione e movimento: sposta la pallina.
    touch := TouchArea {
        property <int> pressed-index: -1;
        property <length> press-x;
        property <length> press-y;
        property <bool> moving;
        property <bool> moved-away;  // l'ultima pressione era un trascinamento, non un clic
        mouse-cursor: self.moving ? MouseCursor.grabbing : root.hovered == root.count ? MouseCursor.pointer : root.hovered >= 0 ? MouseCursor.grab : MouseCursor.default;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                self.press-x = self.mouse-x;
                self.press-y = self.mouse-y;
                self.pressed-index = root.hit(self.mouse-x, self.mouse-y, root.count + root.extra);
                self.moved-away = false;
                keys.focus();
            }
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down && !self.moving {
                keys.focus();
                root.menu(root.hit(self.mouse-x, self.mouse-y, root.count + root.extra), self.mouse-x, self.mouse-y);
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && self.moving {
                self.moving = false;
                self.moved-away = true;
                root.drag-end(false);
            }
            if event.kind == PointerEventKind.cancel && self.moving {
                self.moving = false;
                self.moved-away = true;
                root.drag-end(true);
            }
        }
        moved => {
            // Il «+» non si sposta.
            if self.pressed && self.pressed-index >= 0 && self.pressed-index < root.count {
                Drag.x = self.absolute-position.x + self.mouse-x;
                Drag.y = self.absolute-position.y + self.mouse-y;
                if !self.moving && (abs(self.mouse-x - self.press-x) > Drag.threshold || abs(self.mouse-y - self.press-y) > Drag.threshold) {
                    self.moving = true;
                    root.drag-start(self.pressed-index);
                }
            }
        }
        clicked => {
            if !self.moved-away {
                if root.addable && self.pressed-index == root.count {
                    root.add();
                } else {
                    root.select(self.pressed-index >= 0 ? self.pressed-index : -1);
                }
            }
        }
        double-clicked => {
            if root.hit(self.mouse-x, self.mouse-y, root.count + root.extra) >= 0 && root.hit(self.mouse-x, self.mouse-y, root.count + root.extra) < root.count {
                root.edit(root.hit(self.mouse-x, self.mouse-y, root.count + root.extra));
            }
        }
    }

    // Il focus lo dà la TouchArea alla pressione: preso da qui, il clic non le arriverebbe.
    keys := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.LeftArrow || event.text == Key.UpArrow {
                if event.modifiers.control { root.key-move(-1); } else { root.key-select(-1); }
                return accept;
            }
            if event.text == Key.RightArrow || event.text == Key.DownArrow {
                if event.modifiers.control { root.key-move(1); } else { root.key-select(1); }
                return accept;
            }
            if event.text == Key.Delete {
                root.key-remove();
                return accept;
            }
            if event.text == Key.Return {
                root.key-edit();
                return accept;
            }
            if event.text == Key.Insert || event.text == "+" {
                if root.addable { root.add(); }
                return accept;
            }
            // Il tasto Menu (o Maiusc+F10) apre il menu della pallina scelta, accanto a lei.
            if event.text == Key.Menu || (event.modifiers.shift && event.text == Key.F10) {
                if root.current >= 0 && root.current < root.count {
                    root.menu(root.current, root.center-x(root.current), root.center-y(root.current));
                } else {
                    root.menu(-1, root.c * root.u, root.c * root.u);
                }
                return accept;
            }
            return reject;
        }
    }
}

// Una voce della finestra «Aggiungi»: un'azione della libreria o una ruota, con una pallina
// come quelle della ruota.
component PickRow inherits Rectangle {
    in property <PaletteItem> item;
    callback clicked();

    height: 54px;
    border-radius: 10px;
    background: touch.pressed ? Theme.press : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.quick; }
    accessible-role: button;
    accessible-label: root.item.label;
    accessible-description: root.item.detail;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 17px;
                background: touch.has-hover ? Theme.accent : Theme.ball;
                animate background { duration: Theme.quick; }
                if root.item.glyph != "": Glyph {
                    text: root.item.glyph;
                    font-size: 15px;
                    color: Theme.on-ball;
                }
                if root.item.glyph == "": Text {
                    text: root.item.initial;
                    font-size: 14px;
                    font-weight: 600;
                    color: Theme.on-ball;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.item.label;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
                color: Theme.heading;
            }
            Text {
                text: root.item.detail;
                font-size: 12px;
                overflow: elide;
                color: Theme.faint;
            }
        }
        if root.item.used: VerticalLayout {
            alignment: center;
            Chip { text: @tr("Già nella ruota"); }
        }
    }
}

// L'editor di una ruota: la ruota stessa, da modificare a mano (vedi `WheelPreview`), e accanto
// (sotto, se lo spazio è poco) l'elemento scelto con i suoi comandi, gli stessi del menu del tasto
// destro; senza niente di scelto, come si aggiunge un elemento. Aggiungere e sostituire aprono la
// finestra «Aggiungi» (`add`, `replace`).
// Le misure sono calcolate qui (niente layout): il trascinamento usa le posizioni nella finestra.
component WheelEditor inherits Rectangle {
    in property <[SlotRow]> slots;
    in-out property <int> current: -1;
    in property <string> title;
    in property <float> zoom: 1;
    in property <float> wheel-opacity: 1;
    in property <bool> wide;
    in property <int> max-slots: 8;
    callback select(int);
    callback move(int, int);  // da, a
    callback remove(int);
    callback edit(int);
    callback add(int);  // apre la finestra «Aggiungi»: 0 sulle azioni, 1 sulle ruote
    callback replace(int);  // la stessa finestra, per mettere un altro elemento al posto di questo
    callback new-action();
    callback new-submenu();

    property <length> pad: 24px;
    property <length> size: 304px * root.zoom;
    property <length> wheel-x: root.wide ? root.pad : (root.width - root.size) / 2;
    property <length> panel-x: root.wide ? root.pad + root.size + 36px : root.pad;
    property <length> panel-y: root.wide ? root.pad : root.pad + root.size + 24px;
    property <length> panel-width: root.width - root.panel-x - root.pad;
    property <length> panel-height: root.wide ? root.size : 150px;
    height: root.panel-y + root.panel-height + root.pad;

    property <int> count: root.slots.length;
    property <bool> full: root.count >= root.max-slots;
    property <bool> chosen: root.current >= 0 && root.current < root.count;
    property <SlotRow> slot: root.slots[root.current];

    // Trascinamento di una pallina: dove andrà, o se verrà tolta (fuori dal disco).
    property <int> lift: -1;
    property <int> hit: root.lift < 0 ? -1
        : preview.hit(Drag.x - preview.absolute-position.x, Drag.y - preview.absolute-position.y, root.count + (root.full ? 0 : 1));
    property <bool> removing: root.lift >= 0 && root.hit == -1;
    property <int> drop-at: root.lift < 0 ? -1 : root.hit >= 0 ? min(root.hit, root.count - 1) : root.lift;
    changed removing => { Drag.removing = self.removing; }

    function choose(index: int) {
        root.current = index;
        root.select(index);
    }
    // Sposta l'elemento scelto di un posto (la ruota è un giro: dopo l'ultimo c'è il primo).
    function shift(delta: int) {
        if root.chosen && root.count > 1 {
            root.move(root.current, mod(root.current + delta + root.count, root.count));
        }
    }
    // Fine del trascinamento: si applica quello che l'anteprima mostrava.
    function finish(cancelled: bool) {
        Drag.active = false;
        Drag.removing = false;
        if !cancelled && root.removing {
            preview.settle();
            root.remove(root.lift);
        } else if !cancelled && root.drop-at != root.lift {
            preview.settle();
            root.move(root.lift, root.drop-at);
        }
        root.lift = -1;
    }

    // I menu del tasto destro. Li apre `preview.menu`, che sa su quale pallina si è cliccato:
    // da soli si aprirebbero ovunque, quindi sono spenti.
    slot-menu := ContextMenuArea {
        enabled: false;
        Menu {
            MenuItem {
                title: root.slot.submenu ? @tr("Apri il sottomenu") : @tr("Modifica l'azione");
                activated => { root.edit(root.current); }
            }
            MenuItem {
                title: @tr("Sostituisci…");
                activated => { root.replace(root.current); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Sposta prima");
                enabled: root.count > 1;
                activated => { root.shift(-1); }
            }
            MenuItem {
                title: @tr("Sposta dopo");
                enabled: root.count > 1;
                activated => { root.shift(1); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Togli dalla ruota");
                activated => { root.remove(root.current); }
            }
        }
    }
    add-menu := ContextMenuArea {
        enabled: false;
        Menu {
            MenuItem {
                title: @tr("Aggiungi un'azione…");
                enabled: !root.full;
                activated => { root.add(0); }
            }
            MenuItem {
                title: @tr("Aggiungi un sottomenu…");
                enabled: !root.full;
                activated => { root.add(1); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Nuova azione…");
                enabled: !root.full;
                activated => { root.new-action(); }
            }
            MenuItem {
                title: @tr("Nuovo sottomenu");
                enabled: !root.full;
                activated => { root.new-submenu(); }
            }
        }
    }

    preview := WheelPreview {
        x: root.wheel-x;
        y: root.pad;
        slots: root.slots;
        current: root.current;
        title: root.title;
        zoom: root.zoom;
        opacity: root.wheel-opacity;
        addable: !root.full;
        lift: root.lift;
        drop-at: root.drop-at;
        removing: root.removing;
        ghost-glyph: Drag.glyph;
        ghost-initial: Drag.initial;
        ghost-label: Drag.label;
        select(index) => { root.choose(index); }
        edit(index) => {
            root.choose(index);
            root.edit(index);
        }
        add => { root.add(0); }
        menu(index, x, y) => {
            if index >= 0 && index < root.count {
                root.choose(index);
                slot-menu.show({ x: self.x + x, y: self.y + y });
            } else {
                add-menu.show({ x: self.x + x, y: self.y + y });
            }
        }
        drag-start(index) => {
            root.lift = index;
            root.choose(-1);
            Drag.glyph = root.slots[index].glyph;
            Drag.initial = root.slots[index].initial;
            Drag.label = root.slots[index].label;
            Drag.active = true;
        }
        drag-end(cancelled) => { root.finish(cancelled); }
        key-select(delta) => {
            if root.count > 0 {
                root.choose(root.current < 0 ? (delta > 0 ? 0 : root.count - 1) : mod(root.current + delta + root.count, root.count));
            }
        }
        key-move(delta) => { root.shift(delta); }
        key-remove => {
            if root.chosen { root.remove(root.current); }
        }
        key-edit => {
            if root.chosen { root.edit(root.current); }
        }
    }

    // L'elemento scelto: la sua pallina, il nome e cosa fa; sotto, i suoi comandi.
    if root.chosen: VerticalLayout {
        x: root.panel-x;
        y: root.panel-y;
        width: root.panel-width;
        height: root.panel-height;
        alignment: center;
        spacing: 20px;
        HorizontalLayout {
            spacing: 14px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: 24px;
                    background: Theme.accent;
                    if root.slot.glyph != "": Glyph {
                        text: root.slot.glyph;
                        font-size: 20px;
                        color: Theme.on-accent;
                    }
                    if root.slot.glyph == "": Text {
                        text: root.slot.initial;
                        font-size: 18px;
                        font-weight: 600;
                        color: Theme.on-accent;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                horizontal-stretch: 1;
                Eyebrow { text: @tr("ELEMENTO {} DI {}", root.current + 1, root.count); }
                Text {
                    text: root.slot.label;
                    font-size: 18px;
                    font-weight: 600;
                    overflow: elide;
                    color: Theme.heading;
                }
                Text {
                    text: root.slot.detail;
                    font-size: 13px;
                    overflow: elide;
                    color: Theme.body;
                }
            }
        }
        VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Btn {
                    text: root.slot.submenu ? @tr("Apri il sottomenu") : @tr("Modifica l'azione");
                    glyph: root.slot.submenu ? "\u{E8A7}" : "\u{E70F}";
                    tone: Tone.primary;
                    clicked => { root.edit(root.current); }
                }
                Btn {
                    text: @tr("Sostituisci");
                    glyph: "\u{E8AB}";
                    clicked => { root.replace(root.current); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Btn {
                    text: @tr("Sposta" => "Prima");
                    glyph: "\u{E76B}";
                    enabled: root.count > 1;
                    clicked => { root.shift(-1); }
                }
                Btn {
                    text: @tr("Sposta" => "Dopo");
                    glyph: "\u{E76C}";
                    enabled: root.count > 1;
                    clicked => { root.shift(1); }
                }
                Btn {
                    text: @tr("Togli");
                    glyph: "\u{E711}";
                    tone: Tone.danger;
                    clicked => { root.remove(root.current); }
                }
            }
        }
    }

    // Niente di scelto: come si usa, e come si aggiunge un elemento.
    if !root.chosen: VerticalLayout {
        x: root.panel-x;
        y: root.panel-y;
        width: root.panel-width;
        height: root.panel-height;
        alignment: center;
        spacing: 18px;
        VerticalLayout {
            spacing: 6px;
            Text {
                text: root.count == 0 ? @tr("La ruota è vuota") : root.full ? @tr("La ruota è piena") : @tr("Scegli una pallina");
                font-size: 18px;
                font-weight: 600;
                color: Theme.heading;
            }
            // Altezza fissa, tre righe: in un blocco facoltativo un testo a capo verrebbe misurato
            // su una riga sola (vedi `Page`).
            Text {
                height: 54px;
                text: root.count == 0 ? @tr("Aggiungi le azioni da avere a portata di mano, o altre ruote da aprire come sottomenu.")
                    : root.full ? @tr("Ha {} elementi, il massimo. Per metterne un altro, scegli una pallina e sostituiscila.", root.max-slots)
                    : @tr("Clic per vedere cosa fa, doppio clic per modificarla, tasto destro per tutti i comandi. Trascinala per spostarla, o fuori dal disco per toglierla.");
                font-size: 13px;
                wrap: word-wrap;
                vertical-alignment: top;
                color: Theme.body;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Btn {
                text: @tr("Aggiungi un'azione");
                glyph: "\u{E710}";
                tone: Tone.primary;
                enabled: !root.full;
                clicked => { root.add(0); }
            }
            Btn {
                text: @tr("Sottomenu");
                glyph: "\u{E8A9}";
                enabled: !root.full;
                clicked => { root.add(1); }
            }
        }
    }
}

// ── Finestre di dialogo ──────────────────────────────────────────────────────

// Velo scuro su tutta la finestra e un riquadro al centro. Compare con una dissolvenza e il
// riquadro sale di qualche pixel; Esc la chiude, Invio conferma.
component Dialog inherits Rectangle {
    in property <length> card-width: 460px;
    in property <length> card-height;  // 0 = quanto serve al contenuto
    in property <bool> grab-focus: true;  // false se il contenuto prende il focus da solo
    callback dismissed();
    callback accepted();

    property <bool> shown;
    init => {
        self.shown = true;
        if self.grab-focus { keys.focus(); }
    }
    // Appena aperta, un clic fuori non la chiude: era il secondo di un doppio clic su ciò che
    // l'ha aperta (per esempio il «+» della ruota).
    property <bool> settled;
    Timer {
        interval: 400ms;
        running: !root.settled;
        triggered => { root.settled = true; }
    }

    background: Theme.scrim;
    opacity: self.shown ? 1 : 0;
    animate opacity { duration: 140ms; easing: ease-out; }

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismissed();
                return accept;
            }
            if event.text == Key.Return {
                root.accepted();
                return accept;
            }
            return reject;
        }
        TouchArea {
            // Clic fuori dal riquadro: chiude.
            clicked => {
                if root.settled { root.dismissed(); }
            }
        }
        Rectangle {
            width: min(root.card-width, root.width - 48px);
            height: root.card-height > 0 ? root.card-height : body.preferred-height;
            y: (root.height - self.height) / 2 + (root.shown ? 0px : 12px);
            animate y { duration: 260ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
            border-radius: 18px;
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.card-border;
            drop-shadow-blur: 36px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: #00000088;
            TouchArea { }  // i clic dentro il riquadro non lo chiudono
            body := VerticalLayout {
                padding: 24px;
                spacing: 16px;
                @children
            }
        }
    }
}

// Domanda con titolo, spiegazione e due pulsanti in basso a destra.
component Confirm inherits Dialog {
    in property <string> title;
    in property <string> text;
    in property <string> note;
    in property <string> glyph;
    in property <bool> danger;
    in property <string> cancel-text: @tr("Annulla");
    in property <string> confirm-text;
    accepted => { self.confirmed(); }
    callback confirmed();

    HorizontalLayout {
        spacing: 16px;
        if root.glyph != "": VerticalLayout {
            alignment: start;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 20px;
                background: root.danger ? Theme.danger-soft : Theme.accent-soft;
                Glyph {
                    text: root.glyph;
                    font-size: 17px;
                    color: root.danger ? Theme.danger : Theme.accent;
                }
            }
        }
        VerticalLayout {
            spacing: 6px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-size: 17px;
                font-weight: 600;
                wrap: word-wrap;
                color: Theme.heading;
            }
            if root.text != "": Hint { text: root.text; }
            if root.note != "": Hint {
                text: root.note;
                color: Theme.faint;
            }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: end;
        padding-top: 4px;
        @children
        Btn {
            text: root.cancel-text;
            clicked => { root.dismissed(); }
        }
        Btn {
            text: root.confirm-text;
            glyph: root.danger ? "\u{E74D}" : "";
            tone: root.danger ? Tone.destructive : Tone.primary;
            clicked => { root.confirmed(); }
        }
    }
}

// ── Barra del titolo ─────────────────────────────────────────────────────────

// Un pulsante della barra del titolo, come quelli di Windows: largo 46 px e alto quanto la barra;
// quello per chiudere diventa rosso sotto il mouse.
component CaptionButton {
    in property <string> glyph;
    in property <string> label;  // letto dagli screen reader
    in property <bool> close;
    callback clicked;

    width: 46px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    Rectangle {
        background: root.close && touch.has-hover ? (touch.pressed ? #C42B1CE6 : #C42B1C)
            : touch.pressed ? Theme.press : touch.has-hover ? Theme.hover : transparent;
        animate background { duration: Theme.quick; }
    }
    Glyph {
        text: root.glyph;
        font-size: 10px;
        color: root.close && touch.has-hover ? #FFFFFF : Theme.soft;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// La barra del titolo, al posto di quella di Windows: trascinandola si sposta la finestra; a
// destra riduci a icona e chiudi. Niente ingrandisci: la finestra ha una misura fissa.
component TitleBar inherits Rectangle {
    callback minimize();
    callback close();

    height: Theme.title-bar;
    WindowMoveArea { }
    HorizontalLayout {
        alignment: end;
        CaptionButton {
            glyph: "\u{E921}";
            label: @tr("Riduci a icona");
            clicked => { root.minimize(); }
        }
        CaptionButton {
            glyph: "\u{E8BB}";
            label: @tr("Chiudi");
            close: true;
            clicked => { root.close(); }
        }
    }
}

// ── Finestra ─────────────────────────────────────────────────────────────────

export component SettingsWindow inherits Window {
    title: @tr("Wheelor – Impostazioni");
    // Senza la cornice di Windows: la barra del titolo è disegnata qui (`TitleBar`). La finestra
    // non si ridimensiona: la sua misura la sceglie Rust all'apertura, la più grande che sta nello
    // schermo fino a 1120×780 (vedi settings::fit_window).
    no-frame: true;
    in property <length> fixed-width: 1120px;
    in property <length> fixed-height: 780px;
    preferred-width: root.fixed-width;
    preferred-height: root.fixed-height;
    min-width: root.fixed-width;
    max-width: root.fixed-width;
    min-height: root.fixed-height;
    max-height: root.fixed-height;
    background: Theme.bg;
    default-font-size: 14px;

    // Il tema del sito è scuro: anche i widget standard (campi, menu) vanno in scuro.
    init => {
        Palette.color-scheme = ColorScheme.dark;
        shortcuts.focus();
    }

    // Misure che si adattano alla finestra. Si leggono solo dentro le pagine scorrevoli:
    // se cambiassero la larghezza minima della finestra, dipenderebbero da sé stesse.
    property <length> sidebar-width: 248px;
    property <length> content-width: self.width - self.sidebar-width;
    // L'editor della ruota (largo quanto la pagina, al massimo 1000 px meno i margini): se c'è posto
    // il pannello dell'elemento scelto (almeno 340 px) sta accanto alla ruota, altrimenti sotto.
    // Lo spazio che avanza ingrandisce la ruota, fino al 30%.
    property <length> wheel-card-width: min(self.content-width, 1000px) - 2 * Theme.margin;
    property <bool> wide: self.wheel-card-width >= 304px + 36px + 340px + 48px;
    property <float> preview-zoom: clamp((self.wheel-card-width - 36px - 340px - 48px) / 304px, 1, 1.3);
    // Libreria: l'elenco delle azioni prende un terzo dello spazio (272–380 px), l'editor il resto.
    // Con l'editor stretto, i suoi pulsanti in fondo restano solo icone.
    property <bool> editor-compact: self.content-width - clamp(self.content-width / 3, 272px, 380px) - 1px - 2 * Theme.margin < 380px;

    // ── Dati che arrivano da Rust ───────────────────────────────────────────
    in property <[WheelRow]> wheels;
    in property <[SlotRow]> slots;
    in property <[ActionRow]> actions;
    in property <[PaletteItem]> palette;
    in property <[StepRow]> steps;
    in property <[IconData]> icons;
    in property <[PickItem]> picker-items;
    in property <int> action-count;
    in property <int> max-slots: 8;
    in property <string> status;
    in property <bool> status-error;
    in property <bool> dirty;
    in property <string> undo-text;  // l'ultima modifica che si può annullare ("" = nessuna)
    in property <string> config-path;
    in property <string> version;
    // Versione del Microsoft Store: gli aggiornamenti li fa lo Store.
    in property <bool> store;

    // Scelte con icona, nella lingua attuale: tipi di passo, operazioni, esempi di azioni.
    in property <[Choice]> step-kinds;
    in property <[Choice]> starters;  // i tipi di passo proposti per una nuova azione
    in property <[Choice]> window-ops;
    in property <[Choice]> system-ops;
    in property <[Choice]> clipboard-ops;
    in property <[Choice]> examples;

    // Pagina visibile: 0 ruote, 1 libreria, 2 generale, 3 informazioni.
    in-out property <int> page: 0;

    // Ruota selezionata e suoi campi.
    in-out property <string> current-wheel;
    in-out property <int> current-slot: -1;
    in-out property <string> wh-name;
    in-out property <string> wh-icon;
    in-out property <string> wh-apps;
    in property <bool> wh-main;
    in property <string> wh-hint;
    // Finestra «Aggiungi» della ruota (0 chiusa, 1 aggiunge in fondo, 2 al posto dell'elemento
    // scelto), con le sue schede (0 azioni, 1 ruote come sottomenu) e la ricerca.
    in-out property <int> adding: 0;
    in-out property <int> palette-tab: 0;
    in-out property <string> palette-search;

    // Azione selezionata: nome, icona, scorciatoia e passi.
    in-out property <string> current-action;
    in property <int> current-action-index: -1;  // la sua riga nell'elenco (filtrato) della libreria
    in-out property <string> action-search;
    in-out property <string> ed-label;
    in-out property <string> ed-icon;
    in property <string> ed-usage;
    in-out property <string> ed-hotkey;
    in property <[string]> ed-hotkey-caps;
    in property <string> ed-hotkey-note;  // un problema con la scorciatoia, o che va bene
    in property <bool> ed-hotkey-note-error;
    in-out property <int> current-step: 0;
    // Il passo che si sta trascinando nell'elenco (-1 nessuno).
    property <int> step-drag: -1;
    // Arrivati all'azione da una ruota ("Modifica"): si può tornare lì.
    in-out property <string> return-wheel;
    in property <string> return-wheel-name;

    // I campi del passo selezionato. ed-kind segue l'ordine di `step-kinds`: 0 apri, 1 tasti,
    // 2 testo, 3 comando, 4 attendi, 5 aspetta la finestra, 6 finestra, 7 sistema, 8 appunti,
    // 9 esegui azione. ed-op è l'operazione scelta per finestra, sistema e appunti.
    in-out property <int> ed-kind;
    in-out property <string> ed-command;
    in-out property <int> ed-shell;
    in-out property <int> ed-window;
    in-out property <string> ed-cwd;
    in-out property <bool> ed-admin;
    in-out property <bool> ed-wait;
    in-out property <string> ed-target;
    in-out property <string> ed-args;
    in-out property <string> ed-keys;
    in property <[string]> ed-keys-caps;  // ed-keys come tasti disegnati
    in-out property <string> ed-text;
    in-out property <float> ed-seconds: 1;
    in-out property <string> ed-app;
    in-out property <string> ed-title;
    in-out property <float> ed-timeout: 10;
    in-out property <int> ed-op;
    in property <string> ed-run;  // id dell'azione eseguita dal passo ("" = nessuna)
    in property <string> ed-run-label;
    in property <string> ed-run-glyph;

    // Impostazioni generali. wheel-size: 0 normale, 1 grande, 2 molto grande.
    in-out property <string> hotkey;
    in property <[string]> hotkey-caps;
    in property <string> hotkey-note;  // sotto la scorciatoia: un problema, o che va bene
    in property <bool> hotkey-note-error;
    in-out property <int> wheel-size;
    in-out property <float> wheel-opacity: 100;  // percentuale
    in property <[AccentChoice]> accents;
    in-out property <int> accent;  // indice in `accents`
    in-out property <bool> aim-anywhere;
    in-out property <int> language;  // 0 come Windows, 1 italiano, 2 inglese
    in-out property <bool> autostart;
    in-out property <bool> check-updates: true;

    // Registrazione di una combinazione di tasti: 0 nessuna, 1 la scorciatoia della ruota, 2 i
    // tasti di un passo, 3 la scorciatoia di un'azione. `pressed-caps`: la combinazione premuta
    // finora; `confirming`: tutto rilasciato, fra 2 secondi sarà quella scelta.
    in property <int> listening: 0;
    in property <[string]> pressed-caps;
    in property <bool> confirming;

    // Aggiornamenti. update-version: la nuova versione disponibile ("" = nessuna).
    // update-state: 0 fermo, 1 controllo in corso, 2 conferma, 3 download, 4 installazione.
    in property <string> update-version;
    in property <string> update-size;
    in property <string> update-message;
    in property <bool> update-error;
    in property <int> update-state: 0;
    in property <float> update-progress;

    // Selettore icone (0 chiuso, 1 per l'azione, 2 per la ruota) e finestra di scelta
    // (0 chiusa, 3 app aperte per la ruota, 4 app per "Aspetta la finestra", 5 azione da eseguire).
    in-out property <int> picking-icon: 0;
    in-out property <string> icon-search;
    in-out property <int> picker: 0;
    in property <string> picker-title;
    in-out property <string> picker-search;
    in-out property <bool> confirm-close;
    // Finestra "Aggiungi un passo" e finestra "Nuova azione" (0 chiusa, 1 dalla libreria,
    // 2 dalla ruota: la nuova azione si aggiunge anche lì, 3 dalla ruota al posto dell'elemento scelto).
    in-out property <int> picking-kind: 0;  // 1 aggiungi, 2 cambia il tipo del passo scelto
    in-out property <int> creating: 0;

    // Conferma di eliminazione (0 nessuna, 1 la ruota selezionata, 2 l'azione selezionata):
    // titolo e testo li prepara Rust, che sa dove è usata.
    in-out property <int> deleting: 0;
    in property <string> delete-title;
    in property <string> delete-text;

    // ── Implementati in Rust ────────────────────────────────────────────────
    pure callback glyph(string) -> string;
    callback select-wheel(string);
    callback new-wheel();
    callback ask-delete(int);
    callback confirm-delete();
    callback wheel-edited();
    callback select-slot(int);
    callback add-slot(string, bool, int);
    callback replace-slot(string, bool, int);
    callback move-slot(int, int);
    callback remove-slot(int);
    callback edit-slot(int);
    callback palette-changed();
    callback new-submenu(bool);  // true: al posto dell'elemento scelto
    callback open-picker(int);
    callback picker-search-changed(string);
    callback picked(string);
    callback select-action(string);
    callback new-action(int, int);  // tipo del primo passo o esempio (l'altro è -1)
    callback duplicate-action();
    callback action-edited();
    callback search-actions(string);
    callback return-to-wheel();
    callback select-step(int);
    callback add-step(int);
    callback step-kind-changed();
    callback move-step(int, int);
    callback duplicate-step(int);
    callback remove-step(int);
    callback clear-action-hotkey();
    callback search-icons(string);
    callback pick-icon(string);
    callback browse();
    callback test();
    callback undo();
    callback general-edited();
    callback accent-picked(int);
    callback language-picked(int);
    callback listen(int);
    callback stop-listening();
    callback check-for-updates();
    callback ask-update();
    callback cancel-update();
    callback confirm-update();
    callback open-release-notes();
    callback open-wheelor-site();
    callback open-author-site();
    callback open-config-folder();
    callback save();
    callback close-without-saving();
    callback minimize-window();
    callback close-window();  // come la X di Windows: con modifiche non salvate, chiede prima

    // Apre la finestra «Aggiungi» della ruota (vedi `adding`) sulla scheda `tab`.
    public function open-adding(mode: int, tab: int) {
        root.palette-tab = tab;
        root.palette-search = "";
        root.palette-changed();
        root.adding = mode;
    }

    // Ctrl+Z annulla l'ultima modifica alla struttura (vedi `undo-text`). I campi di testo hanno
    // il loro Ctrl+Z: lì il tasto non arriva fin qui.
    shortcuts := FocusScope {
        key-pressed(event) => {
            if event.modifiers.control && !event.modifiers.shift && (event.text == "z" || event.text == "Z") {
                root.undo();
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            HorizontalLayout {
                vertical-stretch: 1;

                // ── Colonna di navigazione ───────────────────────────────────────
                Rectangle {
                    width: root.sidebar-width;
                    background: Theme.sidebar;
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        background: Theme.line;
                    }
                    // Il logo sta all'altezza della barra del titolo, e come lei sposta la finestra.
                    WindowMoveArea {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: Theme.title-bar + 8px;
                    }
                    VerticalLayout {
                        padding: 16px;
                        padding-top: (Theme.title-bar - 30px) / 2;
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;
                            padding-left: 12px;
                            padding-bottom: 20px;
                            Logo {
                                width: 30px;
                                height: 30px;
                            }
                            Text {
                                text: "Wheelor";
                                font-size: 20px;
                                font-weight: 700;
                                letter-spacing: -0.3px;
                                vertical-alignment: center;
                                color: Theme.heading;
                            }
                        }
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-bottom: 8px;
                            Eyebrow { text: @tr("RUOTE"); }
                        }
                        // Le ruote e, subito sotto l'ultima, "Nuova ruota".
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                alignment: start;
                                spacing: 2px;
                                for wheel in root.wheels: Row {
                                    glyph: wheel.glyph;
                                    text: wheel.name;
                                    detail: wheel.detail;
                                    selected: root.page == 0 && wheel.id == root.current-wheel;
                                    clicked => {
                                        root.page = 0;
                                        root.select-wheel(wheel.id);
                                    }
                                }
                                Row {
                                    glyph: "\u{E710}";
                                    text: @tr("Nuova ruota");
                                    action: true;
                                    clicked => { root.new-wheel(); }
                                }
                            }
                        }
                        VerticalLayout {
                            padding-top: 8px;
                            padding-bottom: 8px;
                            Divider { }
                        }
                        Row {
                            glyph: "\u{E8F1}";
                            text: @tr("Libreria");
                            detail: @tr("{n} azione" | "{n} azioni" % root.action-count);
                            selected: root.page == 1;
                            clicked => {
                                root.return-wheel = "";
                                root.page = 1;
                            }
                        }
                        Row {
                            glyph: "\u{E713}";
                            text: @tr("Generale");
                            selected: root.page == 2;
                            clicked => { root.page = 2; }
                        }
                        Row {
                            glyph: "\u{E946}";
                            text: @tr("Informazioni");
                            detail: root.update-version != "" ? @tr("Nuova versione disponibile") : "";
                            selected: root.page == 3;
                            clicked => { root.page = 3; }
                        }
                        // Nuova versione: un riquadro sempre in vista, con il pulsante per installarla.
                        if root.update-version != "": VerticalLayout {
                            padding-top: 12px;
                            Rectangle {
                                border-radius: 12px;
                                background: Theme.accent-soft;
                                border-width: 1px;
                                border-color: Theme.accent-line;
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 10px;
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Glyph {
                                            width: 18px;
                                            text: "\u{E896}";
                                            font-size: 16px;
                                            color: Theme.accent;
                                        }
                                        VerticalLayout {
                                            spacing: 2px;
                                            Text {
                                                text: @tr("Wheelor {}", root.update-version);
                                                font-size: 14px;
                                                font-weight: 600;
                                                overflow: elide;
                                                color: Theme.heading;
                                            }
                                            Text {
                                                text: @tr("È pronta da installare");
                                                font-size: 12px;
                                                color: Theme.soft;
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        alignment: start;
                                        Btn {
                                            text: @tr("Aggiorna");
                                            glyph: "\u{E896}";
                                            tone: Tone.primary;
                                            clicked => { root.ask-update(); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ── Contenuto: la barra del titolo e sotto la pagina ──────────────────
                VerticalLayout {
                    horizontal-stretch: 1;
                    TitleBar {
                        minimize => { root.minimize-window(); }
                        close => { root.close-window(); }
                    }
                    HorizontalLayout {
                        vertical-stretch: 1;

                        // ── Pagina Ruote ─────────────────────────────────────────────────
                        if root.page == 0: Page {
                            horizontal-stretch: 1;

                            // Nome e icona in alto: il nome si scrive direttamente nel titolo.
                            VerticalLayout {
                                spacing: 16px;
                                NameHeader {
                                    // Senza icona scelta, la stessa icona generica mostrata nella colonna a sinistra.
                                    glyph: root.wh-icon != "" ? root.glyph(root.wh-icon) : root.wh-main ? "\u{E80F}" : "\u{E8A9}";
                                    picking: root.picking-icon == 2;
                                    name <=> root.wh-name;
                                    placeholder: @tr("Ruota senza nome");
                                    name-label: @tr("Nome della ruota");
                                    subtitle: root.wh-hint;
                                    icon-clicked => { root.picking-icon = root.picking-icon == 2 ? 0 : 2; }
                                    edited(text) => { root.wheel-edited(); }
                                }
                                if root.picking-icon == 2: IconPicker {
                                    icons: root.icons;
                                    current: root.wh-icon;
                                    search <=> root.icon-search;
                                    search-changed(text) => { root.search-icons(text); }
                                    picked(code) => { root.pick-icon(code); }
                                }
                            }

                            Section {
                                title: @tr("Elementi");
                                aside: @tr("{} di {}", root.slots.length, root.max-slots);
                                // L'altezza la calcola l'editor (dipende dalla larghezza): il riquadro la segue.
                                Card {
                                    height: editor.height;
                                    editor := WheelEditor {
                                        x: 0px;
                                        y: 0px;
                                        width: parent.width;
                                        slots: root.slots;
                                        current <=> root.current-slot;
                                        title: root.wh-main ? "" : root.wh-name;
                                        zoom: root.wide ? root.preview-zoom : 1;
                                        wheel-opacity: root.wheel-opacity / 100;
                                        wide: root.wide;
                                        max-slots: root.max-slots;
                                        select(index) => { root.select-slot(index); }
                                        move(from, to) => { root.move-slot(from, to); }
                                        remove(index) => { root.remove-slot(index); }
                                        edit(index) => { root.edit-slot(index); }
                                        add(tab) => { root.open-adding(1, tab); }
                                        // Si parte dalla scheda dello stesso tipo dell'elemento da sostituire.
                                        replace(index) => {
                                            root.current-slot = index;
                                            root.open-adding(2, root.slots[index].submenu ? 1 : 0);
                                        }
                                        new-action => { root.creating = 2; }
                                        new-submenu => { root.new-submenu(false); }
                                    }
                                }
                            }

                            // Descrizione breve, su una riga: la sezione è facoltativa (vedi la nota in `Page`).
                            if !root.wh-main: Section {
                                title: @tr("App collegate");
                                description: @tr("Quando usi una di queste app, la scorciatoia apre questa ruota.");
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                        text <=> root.wh-apps;
                                        placeholder-text: @tr("es. notepad.exe, chrome.exe");
                                        edited(text) => { root.wheel-edited(); }
                                    }
                                    Btn {
                                        text: @tr("Scegli tra le app aperte");
                                        glyph: "\u{E737}";
                                        clicked => { root.open-picker(3); }
                                    }
                                }
                            }

                            // Eliminare non serve spesso: in fondo, lontano dal resto.
                            if !root.wh-main: HorizontalLayout {
                                alignment: start;
                                Btn {
                                    text: @tr("Elimina ruota");
                                    glyph: "\u{E74D}";
                                    tone: Tone.danger;
                                    clicked => { root.ask-delete(1); }
                                }
                            }
                        }

                        // ── Pagina Libreria ──────────────────────────────────────────────
                        if root.page == 1: HorizontalLayout {
                            horizontal-stretch: 1;

                            // Elenco delle azioni: un terzo dello spazio, tra 272 e 380 px. Le larghezze preferite
                            // fisse (272 e 544, come 1 a 2) servono: altrimenti il layout partirebbe da quella delle
                            // righe (dettagli lunghi) e l'elenco resterebbe quasi sempre a 380 px.
                            library-column := Rectangle {
                                min-width: 272px;
                                max-width: 380px;
                                preferred-width: 272px;
                                horizontal-stretch: 1;
                                // L'azione selezionata resta in vista (per esempio una appena creata, in fondo).
                                // L'elenco ricalcola altezza e scorrimento quando ridisegna le righe: finché la
                                // riga non c'è ancora, uno scorrimento verrebbe annullato, quindi si riprova.
                                property <int> selected: root.current-action-index;
                                property <length> row-height: 56px;
                                property <int> attempts;
                                changed selected => {
                                    self.attempts = 20;
                                    reveal.running = true;
                                }
                                reveal := Timer {
                                    interval: 16ms;
                                    running: false;
                                    triggered => {
                                        let row = library-column.selected;
                                        let height = library-column.row-height;
                                        library-column.attempts -= 1;
                                        if row < 0 || library-column.attempts <= 0 {
                                            self.running = false;
                                        } else if (row + 1) * height > library-list.content-height {
                                            // La riga non c'è ancora: si riprova al prossimo giro.
                                        } else {
                                            self.running = false;
                                            if row * height < -library-list.content-y {
                                                library-list.content-y = -row * height;
                                            } else if (row + 1) * height > library-list.visible-height - library-list.content-y {
                                                library-list.content-y = library-list.visible-height - (row + 1) * height;
                                            }
                                        }
                                    }
                                }
                                VerticalLayout {
                                    padding-left: 20px;
                                    padding-right: 20px;
                                    padding-top: 4px;
                                    padding-bottom: 20px;
                                    spacing: 14px;
                                    HorizontalLayout {
                                        spacing: 12px;
                                        padding-left: 4px;
                                        Text {
                                            horizontal-stretch: 1;
                                            text: @tr("Libreria");
                                            font-size: 26px;
                                            font-weight: 600;
                                            letter-spacing: -0.4px;
                                            vertical-alignment: center;
                                            color: Theme.heading;
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Btn {
                                                text: @tr("Nuova");
                                                glyph: "\u{E710}";
                                                tone: Tone.primary;
                                                clicked => { root.creating = 1; }
                                            }
                                        }
                                    }
                                    LineEdit {
                                        text <=> root.action-search;
                                        placeholder-text: @tr("Cerca un'azione…");
                                        edited(text) => { root.search-actions(text); }
                                    }
                                    library-list := ListView {
                                        vertical-stretch: 1;
                                        for action in root.actions: Row {
                                            glyph: action.glyph;
                                            text: action.label;
                                            detail: action.detail;
                                            selected: action.id == root.current-action;
                                            clicked => { root.select-action(action.id); }
                                        }
                                    }
                                    if root.actions.length == 0: Hint {
                                        text: root.action-search != "" ? @tr("Nessuna azione trovata.") : @tr("Nessuna azione: creane una con «Nuova».");
                                    }
                                }
                            }
                            Rectangle {
                                width: 1px;
                                background: Theme.line;
                            }

                            if root.current-action == "": Rectangle {
                                preferred-width: 544px;
                                horizontal-stretch: 2;
                                Text {
                                    text: @tr("Seleziona un'azione a sinistra, oppure creane una nuova.");
                                    font-size: 14px;
                                    color: Theme.faint;
                                }
                            }

                            // Editor dell'azione selezionata: nome, passi, scorciatoia. I campi di ogni tipo di
                            // passo stanno in blocchi facoltativi: lì solo testi su una riga (vedi la nota in `Page`).
                            if root.current-action != "": Page {
                                preferred-width: 544px;
                                horizontal-stretch: 2;

                                // Nome e icona in alto, come per le ruote. Arrivati da una ruota, si torna lì.
                                VerticalLayout {
                                    spacing: 16px;
                                    if root.return-wheel != "": HorizontalLayout {
                                        alignment: start;
                                        Btn {
                                            text: @tr("Torna a «{}»", root.return-wheel-name);
                                            glyph: "\u{E72B}";
                                            clicked => { root.return-to-wheel(); }
                                        }
                                    }
                                    NameHeader {
                                        glyph: root.glyph(root.ed-icon);
                                        picking: root.picking-icon == 1;
                                        name <=> root.ed-label;
                                        placeholder: @tr("Azione senza nome");
                                        name-label: @tr("Nome dell'azione");
                                        subtitle: root.ed-usage;
                                        icon-clicked => { root.picking-icon = root.picking-icon == 1 ? 0 : 1; }
                                        edited(text) => { root.action-edited(); }
                                    }
                                    if root.picking-icon == 1: IconPicker {
                                        icons: root.icons;
                                        current: root.ed-icon;
                                        search <=> root.icon-search;
                                        search-changed(text) => { root.search-icons(text); }
                                        picked(code) => { root.pick-icon(code); }
                                    }
                                }

                                // I passi, uno sotto l'altro: quello scelto è aperto con i suoi campi. Si
                                // riordinano trascinandoli; mentre se ne trascina uno sono tutti chiusi e alti
                                // uguali, così il punto in cui rilasciarlo si ricava dalla posizione del cursore.
                                Section {
                                    title: @tr("Cosa fa");
                                    aside: root.steps.length > 1 ? @tr("{n} passo" | "{n} passi" % root.steps.length) : "";
                                    VerticalLayout {
                                        spacing: 10px;
                                        for step[i] in root.steps: card := Rectangle {
                                            property <bool> open: i == root.current-step && root.step-drag < 0;
                                            property <bool> movable: root.steps.length > 1;
                                            property <length> pitch: 52px + 10px;
                                            // Il punto fra i passi (0 = prima del primo) più vicino al cursore.
                                            property <int> target: root.step-drag < 0 ? -1
                                                : max(0, min(root.steps.length, round((Drag.y - (self.absolute-position.y - i * self.pitch)) / self.pitch)));
                                            property <bool> shows-target: root.step-drag >= 0 && self.target != root.step-drag && self.target != root.step-drag + 1;
                                            border-radius: 12px;
                                            background: self.open ? Theme.card : header.has-hover ? Theme.hover : transparent;
                                            border-width: 1px;
                                            border-color: self.open ? Theme.card-border : Theme.line;
                                            opacity: i == root.step-drag ? 0.4 : 1;
                                            animate background { duration: Theme.quick; }
                                            accessible-role: list-item;
                                            accessible-label: "\{i + 1}. \{step.title}: \{step.summary}";

                                            VerticalLayout {
                                                Rectangle {
                                                    height: 52px;
                                                    header := TouchArea {
                                                        property <length> press-x;
                                                        property <length> press-y;
                                                        property <bool> moving;
                                                        property <bool> moved-away;
                                                        mouse-cursor: self.moving ? MouseCursor.grabbing : card.movable ? MouseCursor.grab : MouseCursor.pointer;
                                                        pointer-event(event) => {
                                                            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                                                self.press-x = self.mouse-x;
                                                                self.press-y = self.mouse-y;
                                                                self.moved-away = false;
                                                            }
                                                            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && self.moving {
                                                                let to = card.target;
                                                                self.moving = false;
                                                                self.moved-away = true;
                                                                Drag.active = false;
                                                                root.step-drag = -1;
                                                                root.move-step(i, to);
                                                            }
                                                            if event.kind == PointerEventKind.cancel && self.moving {
                                                                self.moving = false;
                                                                self.moved-away = true;
                                                                Drag.active = false;
                                                                root.step-drag = -1;
                                                            }
                                                        }
                                                        moved => {
                                                            if self.pressed && card.movable {
                                                                Drag.x = self.absolute-position.x + self.mouse-x;
                                                                Drag.y = self.absolute-position.y + self.mouse-y;
                                                                if !self.moving && (abs(self.mouse-x - self.press-x) > Drag.threshold || abs(self.mouse-y - self.press-y) > Drag.threshold) {
                                                                    self.moving = true;
                                                                    Drag.glyph = step.glyph;
                                                                    Drag.initial = "";
                                                                    Drag.label = step.title;
                                                                    Drag.removing = false;
                                                                    Drag.active = true;
                                                                    root.step-drag = i;
                                                                }
                                                            }
                                                        }
                                                        clicked => {
                                                            if !self.moved-away {
                                                                root.select-step(i);
                                                            }
                                                        }
                                                    }
                                                    HorizontalLayout {
                                                        padding-left: 10px;
                                                        padding-right: 8px;
                                                        spacing: 10px;
                                                        if card.movable: Glyph {
                                                            width: 12px;
                                                            text: "\u{E76F}";
                                                            font-size: 12px;
                                                            color: header.has-hover ? Theme.soft : Theme.faint;
                                                        }
                                                        VerticalLayout {
                                                            alignment: center;
                                                            Rectangle {
                                                                width: 22px;
                                                                height: 22px;
                                                                border-radius: 11px;
                                                                background: card.open ? Theme.accent : Theme.hover;
                                                                Text {
                                                                    text: "\{i + 1}";
                                                                    font-size: 12px;
                                                                    font-weight: 600;
                                                                    color: card.open ? Theme.on-accent : Theme.soft;
                                                                }
                                                            }
                                                        }
                                                        Glyph {
                                                            width: 20px;
                                                            text: step.glyph;
                                                            font-size: 17px;
                                                            color: card.open ? Theme.accent : Theme.soft;
                                                        }
                                                        VerticalLayout {
                                                            alignment: center;
                                                            spacing: 1px;
                                                            horizontal-stretch: 1;
                                                            Text {
                                                                text: step.title;
                                                                font-size: 14px;
                                                                font-weight: 600;
                                                                overflow: elide;
                                                                color: Theme.heading;
                                                            }
                                                            if step.summary != "": Text {
                                                                text: step.summary;
                                                                font-size: 12px;
                                                                overflow: elide;
                                                                color: Theme.faint;
                                                            }
                                                        }
                                                        if card.open: HorizontalLayout {
                                                            spacing: 2px;
                                                            VerticalLayout {
                                                                alignment: center;
                                                                IconBtn {
                                                                    glyph: "\u{E8AB}";
                                                                    label: @tr("Cambia tipo di passo");
                                                                    clicked => { root.picking-kind = 2; }
                                                                }
                                                            }
                                                            // Con l'editor stretto restano solo i pulsanti essenziali: si sposta trascinando.
                                                            if card.movable && !root.editor-compact: VerticalLayout {
                                                                alignment: center;
                                                                IconBtn {
                                                                    glyph: "\u{E70E}";
                                                                    label: @tr("Sposta prima");
                                                                    enabled: i > 0;
                                                                    clicked => { root.move-step(i, i - 1); }
                                                                }
                                                            }
                                                            if card.movable && !root.editor-compact: VerticalLayout {
                                                                alignment: center;
                                                                IconBtn {
                                                                    glyph: "\u{E70D}";
                                                                    label: @tr("Sposta dopo");
                                                                    enabled: i < root.steps.length - 1;
                                                                    clicked => { root.move-step(i, i + 2); }
                                                                }
                                                            }
                                                            if !root.editor-compact: VerticalLayout {
                                                                alignment: center;
                                                                IconBtn {
                                                                    glyph: "\u{E8C8}";
                                                                    label: @tr("Duplica il passo");
                                                                    clicked => { root.duplicate-step(i); }
                                                                }
                                                            }
                                                            if card.movable: VerticalLayout {
                                                                alignment: center;
                                                                IconBtn {
                                                                    glyph: "\u{E74D}";
                                                                    label: @tr("Elimina il passo");
                                                                    danger: true;
                                                                    clicked => { root.remove-step(i); }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }

                                                if card.open: VerticalLayout {
                                                    padding-left: 16px;
                                                    padding-right: 16px;
                                                    padding-top: 4px;
                                                    padding-bottom: 16px;
                                                    spacing: 18px;

                                                    if root.ed-kind == 0: VerticalLayout {
                                                        spacing: 18px;
                                                        Field {
                                                            label: @tr("App, file, cartella o sito web");
                                                            tokens: true;
                                                            insert(token) => {
                                                                root.ed-target += token;
                                                                root.action-edited();
                                                            }
                                                            HorizontalLayout {
                                                                spacing: 8px;
                                                                LineEdit {
                                                                    text <=> root.ed-target;
                                                                    placeholder-text: @tr("es. notepad.exe, C:\\Documenti, https://…");
                                                                    edited(text) => { root.action-edited(); }
                                                                }
                                                                Btn {
                                                                    text: @tr("Sfoglia");
                                                                    glyph: "\u{E838}";
                                                                    clicked => { root.browse(); }
                                                                }
                                                            }
                                                        }
                                                        Field {
                                                            label: @tr("Opzioni di avvio (facoltative)");
                                                            tokens: true;
                                                            insert(token) => {
                                                                root.ed-args += token;
                                                                root.action-edited();
                                                            }
                                                            LineEdit {
                                                                text <=> root.ed-args;
                                                                edited(text) => { root.action-edited(); }
                                                            }
                                                        }
                                                    }

                                                    if root.ed-kind == 1: VerticalLayout {
                                                        spacing: 18px;
                                                        Field {
                                                            label: @tr("Combinazione di tasti");
                                                            KeyField {
                                                                caps: root.ed-keys-caps;
                                                                pressed: root.pressed-caps;
                                                                confirming: root.confirming;
                                                                listening: root.listening == 2;
                                                                empty-text: @tr("Clic qui, poi premi i tasti");
                                                                clicked => { root.listen(2); }
                                                            }
                                                        }
                                                        // I tasti che non si possono premere nel campo (Esc annulla) o che la
                                                        // tastiera forse non ha, in una griglia che va a capo quando lo spazio non basta.
                                                        Field {
                                                            label: @tr("Altri tasti");
                                                            OptionGrid {
                                                                cell: 112px;
                                                                choices: [
                                                                    { glyph: "\u{E711}", label: "Esc", hint: "" },
                                                                    { glyph: "\u{E768}", label: @tr("Play/Pausa"), hint: "" },
                                                                    { glyph: "\u{E893}", label: @tr("Successivo"), hint: "" },
                                                                    { glyph: "\u{E892}", label: @tr("Precedente"), hint: "" },
                                                                    { glyph: "\u{E995}", label: "Volume +", hint: "" },
                                                                    { glyph: "\u{E993}", label: "Volume −", hint: "" },
                                                                    { glyph: "\u{E74F}", label: @tr("Muto"), hint: "" },
                                                                ];
                                                                selected(index) => {
                                                                    root.ed-keys = ["Esc", "MediaPlayPause", "MediaNext", "MediaPrev", "VolumeUp", "VolumeDown", "VolumeMute"][index];
                                                                    self.current = -1;
                                                                    root.action-edited();
                                                                }
                                                            }
                                                        }
                                                    }

                                                    if root.ed-kind == 2: Field {
                                                        label: @tr("Testo da scrivere");
                                                        tokens: true;
                                                        insert(token) => {
                                                            root.ed-text += token;
                                                            root.action-edited();
                                                        }
                                                        TextEdit {
                                                            text <=> root.ed-text;
                                                            min-height: 110px;
                                                            edited(text) => { root.action-edited(); }
                                                        }
                                                    }

                                                    if root.ed-kind == 3: VerticalLayout {
                                                        spacing: 18px;
                                                        Field {
                                                            label: @tr("Comando");
                                                            tokens: true;
                                                            insert(token) => {
                                                                root.ed-command += token;
                                                                root.action-edited();
                                                            }
                                                            TextEdit {
                                                                text <=> root.ed-command;
                                                                min-height: 110px;
                                                                edited(text) => { root.action-edited(); }
                                                            }
                                                        }
                                                        HorizontalLayout {
                                                            spacing: 16px;
                                                            Field {
                                                                label: @tr("Esegui con");
                                                                horizontal-stretch: 1;
                                                                ComboBox {
                                                                    model: ["PowerShell", "PowerShell 7", @tr("Prompt dei comandi")];
                                                                    current-index <=> root.ed-shell;
                                                                    selected(value) => { root.action-edited(); }
                                                                }
                                                            }
                                                            Field {
                                                                label: @tr("Finestra");
                                                                horizontal-stretch: 1;
                                                                ComboBox {
                                                                    model: [@tr("Nascosta"), @tr("Visibile"), @tr("Visibile, resta aperta")];
                                                                    current-index <=> root.ed-window;
                                                                    selected(value) => { root.action-edited(); }
                                                                }
                                                            }
                                                        }
                                                        Field {
                                                            label: @tr("Cartella di lavoro");
                                                            LineEdit {
                                                                text <=> root.ed-cwd;
                                                                placeholder-text: @tr("Facoltativa");
                                                                edited(text) => { root.action-edited(); }
                                                            }
                                                        }
                                                        Toggle {
                                                            text: @tr("Esegui come amministratore");
                                                            checked <=> root.ed-admin;
                                                            toggled => { root.action-edited(); }
                                                        }
                                                        // Nascosto, il comando si aspetta sempre (serve a leggerne il risultato).
                                                        if root.ed-window != 0: Toggle {
                                                            text: @tr("Aspetta che finisca prima di continuare");
                                                            checked <=> root.ed-wait;
                                                            toggled => { root.action-edited(); }
                                                        }
                                                    }

                                                    if root.ed-kind == 4: Field {
                                                        label: @tr("Quanto aspettare");
                                                        HorizontalLayout {
                                                            spacing: 12px;
                                                            ValueSlider {
                                                                label: @tr("Secondi");
                                                                minimum: 0.1;
                                                                maximum: 10;
                                                                step: 0.1;
                                                                value <=> root.ed-seconds;
                                                                changed(value) => { root.action-edited(); }
                                                            }
                                                            Text {
                                                                width: 56px;
                                                                text: @tr("{} s", round(root.ed-seconds * 10) / 10);
                                                                font-size: 14px;
                                                                font-weight: 600;
                                                                horizontal-alignment: right;
                                                                vertical-alignment: center;
                                                                color: Theme.heading;
                                                            }
                                                        }
                                                    }

                                                    if root.ed-kind == 5: VerticalLayout {
                                                        spacing: 18px;
                                                        Field {
                                                            label: @tr("App da aspettare");
                                                            HorizontalLayout {
                                                                spacing: 8px;
                                                                LineEdit {
                                                                    text <=> root.ed-app;
                                                                    placeholder-text: @tr("es. notepad.exe");
                                                                    edited(text) => { root.action-edited(); }
                                                                }
                                                                Btn {
                                                                    text: @tr("Scegli");
                                                                    glyph: "\u{E737}";
                                                                    clicked => { root.open-picker(4); }
                                                                }
                                                            }
                                                        }
                                                        Field {
                                                            label: @tr("Titolo della finestra (facoltativo)");
                                                            LineEdit {
                                                                text <=> root.ed-title;
                                                                placeholder-text: @tr("Basta una parte del titolo");
                                                                edited(text) => { root.action-edited(); }
                                                            }
                                                        }
                                                        Field {
                                                            label: @tr("Aspetta al massimo");
                                                            HorizontalLayout {
                                                                spacing: 12px;
                                                                ValueSlider {
                                                                    label: @tr("Secondi");
                                                                    minimum: 1;
                                                                    maximum: 60;
                                                                    step: 1;
                                                                    value <=> root.ed-timeout;
                                                                    changed(value) => { root.action-edited(); }
                                                                }
                                                                Text {
                                                                    width: 56px;
                                                                    text: @tr("{} s", round(root.ed-timeout));
                                                                    font-size: 14px;
                                                                    font-weight: 600;
                                                                    horizontal-alignment: right;
                                                                    vertical-alignment: center;
                                                                    color: Theme.heading;
                                                                }
                                                            }
                                                        }
                                                    }

                                                    if root.ed-kind == 6: OptionGrid {
                                                        choices: root.window-ops;
                                                        current <=> root.ed-op;
                                                        selected(index) => { root.action-edited(); }
                                                    }

                                                    if root.ed-kind == 7: OptionGrid {
                                                        choices: root.system-ops;
                                                        current <=> root.ed-op;
                                                        selected(index) => { root.action-edited(); }
                                                    }

                                                    if root.ed-kind == 8: VerticalLayout {
                                                        spacing: 18px;
                                                        OptionGrid {
                                                            choices: root.clipboard-ops;
                                                            current <=> root.ed-op;
                                                            selected(index) => { root.action-edited(); }
                                                        }
                                                        if root.ed-op == 2: Field {
                                                            label: @tr("Testo da mettere negli appunti");
                                                            tokens: true;
                                                            insert(token) => {
                                                                root.ed-text += token;
                                                                root.action-edited();
                                                            }
                                                            TextEdit {
                                                                text <=> root.ed-text;
                                                                min-height: 90px;
                                                                edited(text) => { root.action-edited(); }
                                                            }
                                                        }
                                                    }

                                                    if root.ed-kind == 9: Field {
                                                        label: @tr("Azione da eseguire");
                                                        HorizontalLayout {
                                                            spacing: 8px;
                                                            Rectangle {
                                                                horizontal-stretch: 1;
                                                                height: Theme.control;
                                                                border-radius: 8px;
                                                                background: Theme.card;
                                                                border-width: 1px;
                                                                border-color: Theme.card-border;
                                                                HorizontalLayout {
                                                                    padding-left: 10px;
                                                                    padding-right: 10px;
                                                                    spacing: 10px;
                                                                    if root.ed-run-label != "": Glyph {
                                                                        width: 18px;
                                                                        text: root.ed-run-glyph;
                                                                        font-size: 15px;
                                                                        color: Theme.soft;
                                                                    }
                                                                    Text {
                                                                        text: root.ed-run-label != "" ? root.ed-run-label : @tr("Nessuna azione scelta");
                                                                        font-size: 14px;
                                                                        vertical-alignment: center;
                                                                        overflow: elide;
                                                                        color: root.ed-run-label != "" ? Theme.text : Theme.faint;
                                                                    }
                                                                }
                                                            }
                                                            Btn {
                                                                text: @tr("Scegli");
                                                                glyph: "\u{E8F1}";
                                                                clicked => { root.open-picker(5); }
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            // Dove finirà il passo trascinato: una linea nello spazio sopra questo
                                            // passo, o sotto l'ultimo.
                                            if card.shows-target && card.target == i: Rectangle {
                                                x: 12px;
                                                y: -6px;
                                                width: parent.width - 24px;
                                                height: 2px;
                                                border-radius: 1px;
                                                background: Theme.accent;
                                            }
                                            if card.shows-target && card.target == root.steps.length && i == root.steps.length - 1: Rectangle {
                                                x: 12px;
                                                y: parent.height + 4px;
                                                width: parent.width - 24px;
                                                height: 2px;
                                                border-radius: 1px;
                                                background: Theme.accent;
                                            }
                                        }
                                        HorizontalLayout {
                                            alignment: start;
                                            Btn {
                                                text: @tr("Aggiungi passo");
                                                glyph: "\u{E710}";
                                                clicked => { root.picking-kind = 1; }
                                            }
                                        }
                                    }
                                }

                                // Una scorciatoia propria esegue l'azione anche senza aprire la ruota.
                                Section {
                                    title: @tr("Scorciatoia");
                                    description: @tr("Esegue l'azione anche senza aprire la ruota.");
                                    HorizontalLayout {
                                        spacing: 4px;
                                        alignment: start;
                                        KeyField {
                                            width: 240px;
                                            caps: root.ed-hotkey-caps;
                                            pressed: root.pressed-caps;
                                            confirming: root.confirming;
                                            listening: root.listening == 3;
                                            empty-text: @tr("Nessuna: clic per sceglierla");
                                            clicked => { root.listen(3); }
                                        }
                                        if root.ed-hotkey != "": IconBtn {
                                            glyph: "\u{E711}";
                                            label: @tr("Togli la scorciatoia");
                                            clicked => { root.clear-action-hotkey(); }
                                        }
                                    }
                                    if root.ed-hotkey-note != "": Text {
                                        text: root.ed-hotkey-note;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                        color: root.ed-hotkey-note-error ? Theme.danger : Theme.soft;
                                    }
                                }

                                // Provare l'azione appena preparata; duplicarla o eliminarla. Con poco spazio
                                // Duplica ed Elimina restano solo icone.
                                HorizontalLayout {
                                    spacing: 8px;
                                    Btn {
                                        text: @tr("Prova azione");
                                        glyph: "\u{E768}";
                                        clicked => { root.test(); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    if !root.editor-compact: Btn {
                                        text: @tr("Duplica");
                                        glyph: "\u{E8C8}";
                                        clicked => { root.duplicate-action(); }
                                    }
                                    if !root.editor-compact: Btn {
                                        text: @tr("Elimina");
                                        glyph: "\u{E74D}";
                                        tone: Tone.danger;
                                        clicked => { root.ask-delete(2); }
                                    }
                                    if root.editor-compact: IconBtn {
                                        glyph: "\u{E8C8}";
                                        label: @tr("Duplica");
                                        clicked => { root.duplicate-action(); }
                                    }
                                    if root.editor-compact: IconBtn {
                                        glyph: "\u{E74D}";
                                        label: @tr("Elimina");
                                        danger: true;
                                        clicked => { root.ask-delete(2); }
                                    }
                                }
                            }
                        }

                        // ── Pagina Generale ──────────────────────────────────────────────
                        if root.page == 2: Page {
                            horizontal-stretch: 1;
                            PageHeader { title: @tr("Generale"); }

                            Section {
                                title: @tr("Ruota");
                                Card {
                                    VerticalLayout {
                                        SettingRow {
                                            title: @tr("Scorciatoia");
                                            VerticalLayout {
                                                spacing: 6px;
                                                KeyField {
                                                    width: 260px;
                                                    caps: root.hotkey-caps;
                                                    pressed: root.pressed-caps;
                                                    confirming: root.confirming;
                                                    listening: root.listening == 1;
                                                    clicked => { root.listen(1); }
                                                }
                                                if root.hotkey-note != "": Text {
                                                    width: 260px;
                                                    text: root.hotkey-note;
                                                    font-size: 12px;
                                                    wrap: word-wrap;
                                                    color: root.hotkey-note-error ? Theme.danger : Theme.soft;
                                                }
                                            }
                                        }
                                        Divider { }
                                        SettingRow {
                                            title: @tr("Punta da tutto lo schermo");
                                            description: @tr("Conta solo la direzione del mouse, anche fuori dalla ruota.");
                                            Toggle {
                                                checked <=> root.aim-anywhere;
                                                toggled => { root.general-edited(); }
                                            }
                                        }
                                    }
                                }
                            }

                            Section {
                                title: @tr("Aspetto");
                                Card {
                                    VerticalLayout {
                                        SettingRow {
                                            title: @tr("Colore");
                                            description: root.accents.length > root.accent && root.accent >= 0 ? root.accents[root.accent].name : "";
                                            Swatches {
                                                choices: root.accents;
                                                current <=> root.accent;
                                                selected(index) => { root.accent-picked(index); }
                                            }
                                        }
                                        Divider { }
                                        SettingRow {
                                            title: @tr("Opacità");
                                            HorizontalLayout {
                                                spacing: 12px;
                                                ValueSlider {
                                                    width: 220px;
                                                    label: @tr("Opacità della ruota");
                                                    minimum: 40;
                                                    maximum: 100;
                                                    step: 5;
                                                    value <=> root.wheel-opacity;
                                                    changed(value) => { root.general-edited(); }
                                                }
                                                Text {
                                                    width: 40px;
                                                    text: "\{root.wheel-opacity}%";
                                                    font-size: 14px;
                                                    font-weight: 600;
                                                    horizontal-alignment: right;
                                                    vertical-alignment: center;
                                                    color: Theme.heading;
                                                }
                                            }
                                        }
                                        Divider { }
                                        SettingRow {
                                            title: @tr("Dimensione");
                                            Segmented {
                                                width: 300px;
                                                labels: [@tr("Normale"), @tr("Grande"), @tr("Molto grande")];
                                                current <=> root.wheel-size;
                                                selected(index) => { root.general-edited(); }
                                            }
                                        }
                                    }
                                }
                            }

                            Section {
                                title: @tr("Sistema");
                                Card {
                                    VerticalLayout {
                                        SettingRow {
                                            title: @tr("Lingua");
                                            Segmented {
                                                width: 330px;
                                                // I nomi delle lingue restano sempre nella loro lingua.
                                                labels: [@tr("Come Windows"), "Italiano", "English"];
                                                current <=> root.language;
                                                selected(index) => { root.language-picked(index); }
                                            }
                                        }
                                        Divider { }
                                        SettingRow {
                                            title: @tr("Avvia con Windows");
                                            description: @tr("La ruota è pronta appena accendi il PC.");
                                            Toggle {
                                                checked <=> root.autostart;
                                                toggled => { root.general-edited(); }
                                            }
                                        }
                                        if !root.store: Divider { }
                                        // Descrizione breve, su una riga: la riga è facoltativa (vedi la nota in `Page`).
                                        if !root.store: SettingRow {
                                            title: @tr("Cerca aggiornamenti");
                                            description: @tr("Ti avvisa quando esce una nuova versione.");
                                            Toggle {
                                                checked <=> root.check-updates;
                                                toggled => { root.general-edited(); }
                                            }
                                        }
                                        Divider { }
                                        SettingRow {
                                            title: @tr("File delle impostazioni");
                                            description: root.config-path;
                                            Btn {
                                                text: @tr("Apri cartella");
                                                glyph: "\u{E838}";
                                                clicked => { root.open-config-folder(); }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ── Pagina Informazioni ──────────────────────────────────────────
                        // Il widget AboutSlint è richiesto dalla licenza gratuita di Slint (in una schermata
                        // "Informazioni" raggiungibile dal menu principale).
                        if root.page == 3: Page {
                            horizontal-stretch: 1;
                            PageHeader { title: @tr("Informazioni"); }

                            Card {
                                HorizontalLayout {
                                    padding: 20px;
                                    spacing: 16px;
                                    Logo {
                                        width: 48px;
                                        height: 48px;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: @tr("Wheelor {}", root.version);
                                            font-size: 17px;
                                            font-weight: 600;
                                            color: Theme.heading;
                                        }
                                        Hint { text: @tr("Azioni rapide su una ruota attorno al cursore."); }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Btn {
                                            text: "wheelor.app";
                                            glyph: "\u{E774}";
                                            clicked => { root.open-wheelor-site(); }
                                        }
                                    }
                                }
                            }

                            // Una sola sezione per le due versioni (niente `if` attorno a testi che vanno a
                            // capo, vedi la nota in `Page`): nello Store i pulsanti non ci sono.
                            Section {
                                title: @tr("Aggiornamenti");
                                Card {
                                    SettingRow {
                                        title: root.update-version != "" ? @tr("È disponibile Wheelor {}", root.update-version) : root.update-state == 1 ? @tr("Controllo in corso…") : @tr("Versione {}", root.version);
                                        description: root.store ? @tr("Arrivano da soli dal Microsoft Store.") : root.update-message;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            if !root.store && root.update-version != "": Btn {
                                                text: @tr("Novità");
                                                glyph: "\u{E8A7}";
                                                clicked => { root.open-release-notes(); }
                                            }
                                            if !root.store && root.update-version != "": Btn {
                                                text: @tr("Aggiorna");
                                                glyph: "\u{E896}";
                                                tone: Tone.primary;
                                                clicked => { root.ask-update(); }
                                            }
                                            if !root.store && root.update-version == "": Btn {
                                                text: @tr("Controlla ora");
                                                glyph: "\u{E72C}";
                                                enabled: root.update-state != 1;
                                                clicked => { root.check-for-updates(); }
                                            }
                                        }
                                    }
                                }
                                if root.update-error && !root.store: Hint {
                                    text: @tr("Puoi anche scaricare l'ultima versione da wheelor.app e installarla sopra quella attuale: ruote e azioni restano.");
                                }
                            }

                            Section {
                                title: @tr("Sviluppato da");
                                Card {
                                    HorizontalLayout {
                                        padding: 20px;
                                        spacing: 16px;
                                        // Il segno al centro di un riquadro largo come il logo di Wheelor qui sopra.
                                        Rectangle {
                                            width: 48px;
                                            height: 48px;
                                            AuthorMark { height: 40px; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 4px;
                                            horizontal-stretch: 1;
                                            // Come sul sito: il nome in grassetto, il cognome più leggero.
                                            HorizontalLayout {
                                                alignment: start;
                                                spacing: 6px;
                                                Text {
                                                    text: "Gabriele";
                                                    font-size: 17px;
                                                    font-weight: 600;
                                                    color: Theme.heading;
                                                }
                                                Text {
                                                    text: "Iovino";
                                                    font-size: 17px;
                                                    color: Theme.soft;
                                                }
                                            }
                                            Hint { text: "gabrieleiovino.it"; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Btn {
                                                text: @tr("Visita il sito");
                                                glyph: "\u{E8A7}";
                                                clicked => { root.open-author-site(); }
                                            }
                                        }
                                    }
                                }
                            }

                            Section {
                                title: @tr("Crediti");
                                Hint {
                                    text: @tr("Le icone sono quelle di Windows (Segoe Fluent Icons); i loro nomi vengono dalla documentazione Microsoft, con licenza CC BY 4.0.");
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    AboutSlint { }
                                }
                            }
                        }
                    }
                }
            }

            // ── Barra inferiore: stato e salvataggio ───────────────────────────────
            Rectangle {
                height: 60px;
                background: Theme.sidebar;
                Rectangle {
                    y: 0px;
                    height: 1px;
                    background: Theme.line;
                }
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 16px;
                    padding-top: 14px;
                    padding-bottom: 14px;
                    spacing: 10px;
                    if root.dirty || root.status-error: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: root.status-error ? Theme.danger : Theme.accent;
                        }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.status != "" ? root.status : root.dirty ? @tr("Modifiche non salvate") : "";
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                        color: root.status-error ? Theme.danger : Theme.soft;
                    }
                    // Le modifiche alla struttura (elementi delle ruote, passi, azioni e ruote create o
                    // eliminate) si possono annullare, anche con Ctrl+Z.
                    if root.undo-text != "": Btn {
                        text: @tr("Undo" => "Annulla");
                        glyph: "\u{E7A7}";
                        clicked => { root.undo(); }
                    }
                    Btn {
                        text: @tr("Salva");
                        glyph: "\u{E74E}";
                        tone: Tone.primary;
                        enabled: root.dirty;
                        clicked => { root.save(); }
                    }
                }
            }
        }
    }

    // ── Registrazione dei tasti: un clic in qualunque altro punto la annulla ────
    if root.listening != 0: TouchArea {
        clicked => { root.stop-listening(); }
    }

    // ── Aggiungi alla ruota: un'azione o un'altra ruota (in fondo, o al posto dell'elemento scelto) ──
    if root.adding != 0: Dialog {
        card-width: 560px;
        card-height: min(640px, root.height - 80px);
        grab-focus: false;  // il focus va al campo di ricerca
        dismissed => { root.adding = 0; }
        VerticalLayout {
            spacing: 4px;
            Text {
                text: root.adding == 2 ? @tr("Al posto di «{}»", root.slots[root.current-slot].label)
                    : @tr("Aggiungi a «{}»", root.wh-name != "" ? root.wh-name : @tr("Ruota senza nome"));
                font-size: 20px;
                font-weight: 600;
                overflow: elide;
                color: Theme.heading;
            }
            Text {
                text: root.palette-tab == 0 ? @tr("Un'azione della libreria.") : @tr("Un'altra ruota, che si apre come sottomenu.");
                font-size: 13px;
                color: Theme.body;
            }
        }
        Segmented {
            labels: [@tr("Azioni"), @tr("Sottomenu")];
            glyphs: ["\u{E8F1}", "\u{E8A9}"];
            current <=> root.palette-tab;
            selected(index) => { root.palette-changed(); }
        }
        LineEdit {
            text <=> root.palette-search;
            placeholder-text: root.palette-tab == 0 ? @tr("Cerca un'azione…") : @tr("Cerca una ruota…");
            edited(text) => { root.palette-changed(); }
            init => { self.focus(); }
        }
        Rectangle {
            vertical-stretch: 1;
            ListView {
                for entry in root.palette: PickRow {
                    item: entry;
                    clicked => {
                        if root.adding == 2 {
                            root.replace-slot(entry.id, entry.submenu, root.current-slot);
                        } else {
                            root.add-slot(entry.id, entry.submenu, -1);
                        }
                        root.adding = 0;
                    }
                }
            }
            if root.palette.length == 0: Hint {
                x: 0px;
                y: 8px;
                width: parent.width;
                text: root.palette-search != "" ? @tr("Niente da mostrare.") : root.palette-tab == 1 ? @tr("Nessuna ruota da usare come sottomenu: creane una nuova.") : @tr("La libreria è vuota: crea una nuova azione.");
            }
        }
        // Qualcosa che non c'è ancora: si crea e va subito nella ruota.
        HorizontalLayout {
            spacing: 8px;
            if root.palette-tab == 0: Btn {
                text: @tr("Nuova azione");
                glyph: "\u{E710}";
                clicked => {
                    root.creating = root.adding == 2 ? 3 : 2;
                    root.adding = 0;
                }
            }
            if root.palette-tab == 1: Btn {
                text: @tr("Nuovo sottomenu");
                glyph: "\u{E710}";
                clicked => {
                    root.new-submenu(root.adding == 2);
                    root.adding = 0;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            Btn {
                text: @tr("Annulla");
                clicked => { root.adding = 0; }
            }
        }
    }

    // ── Finestra di scelta: azione, sottomenu o app ─────────────────────────────
    if root.picker != 0: Dialog {
        card-width: 520px;
        card-height: min(600px, root.height - 80px);
        grab-focus: false;  // il focus va al campo di ricerca
        dismissed => { root.picker = 0; }
        Text {
            text: root.picker-title;
            font-size: 20px;
            font-weight: 600;
            color: Theme.heading;
        }
        LineEdit {
            text <=> root.picker-search;
            placeholder-text: @tr("Cerca…");
            edited(text) => { root.picker-search-changed(text); }
            init => { self.focus(); }
        }
        ListView {
            vertical-stretch: 1;
            for item in root.picker-items: Row {
                glyph: item.glyph;
                text: item.label;
                detail: item.detail;
                clicked => { root.picked(item.id); }
            }
        }
        if root.picker-items.length == 0: Hint { text: @tr("Niente da mostrare."); }
        HorizontalLayout {
            alignment: end;
            Btn {
                text: @tr("Annulla");
                clicked => { root.picker = 0; }
            }
        }
    }

    // ── Tipo di passo: da aggiungere, o al posto di quello scelto ─────────────────
    if root.picking-kind != 0: Dialog {
        card-width: 600px;
        dismissed => { root.picking-kind = 0; }
        Text {
            text: root.picking-kind == 1 ? @tr("Aggiungi un passo") : @tr("Cambia tipo di passo");
            font-size: 20px;
            font-weight: 600;
            color: Theme.heading;
        }
        ChoiceTiles {
            choices: root.step-kinds;
            picked(index) => {
                if root.picking-kind == 1 {
                    root.add-step(index);
                } else {
                    root.ed-kind = index;
                    root.step-kind-changed();
                }
                root.picking-kind = 0;
            }
        }
        HorizontalLayout {
            alignment: end;
            Btn {
                text: @tr("Annulla");
                clicked => { root.picking-kind = 0; }
            }
        }
    }

    // ── Nuova azione: da un tipo di passo o da un esempio ───────────────────────
    if root.creating != 0: Dialog {
        card-width: 640px;
        card-height: min(700px, root.height - 60px);
        dismissed => { root.creating = 0; }
        VerticalLayout {
            spacing: 4px;
            Text {
                text: root.creating == 3 ? @tr("Nuova azione al posto di «{}»", root.slots[root.current-slot].label)
                    : root.creating == 2 ? @tr("Nuova azione per «{}»", root.wh-name) : @tr("Nuova azione");
                font-size: 20px;
                font-weight: 600;
                overflow: elide;
                color: Theme.heading;
            }
            Hint { text: @tr("Parti da un passo o da un esempio: dopo puoi cambiare tutto e aggiungere altri passi."); }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 12px;
                padding-right: 14px;
                Eyebrow { text: @tr("UN PASSO"); }
                ChoiceTiles {
                    choices: root.starters;
                    picked(index) => { root.new-action(index, -1); }
                }
                VerticalLayout { height: 6px; }
                Eyebrow { text: @tr("ESEMPI"); }
                ChoiceTiles {
                    choices: root.examples;
                    picked(index) => { root.new-action(-1, index); }
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            Btn {
                text: @tr("Annulla");
                clicked => { root.creating = 0; }
            }
        }
    }

    // ── Conferma di eliminazione ───────────────────────────────────────────────
    if root.deleting != 0: Confirm {
        title: root.delete-title;
        text: root.delete-text;
        note: @tr("Diventa definitivo solo quando premi Salva.");
        glyph: "\u{E74D}";
        danger: true;
        confirm-text: @tr("Elimina");
        dismissed => { root.deleting = 0; }
        confirmed => { root.confirm-delete(); }
    }

    // ── Aggiornamento: conferma, poi download e avvio dell'installazione ────────
    if root.update-state == 2: Confirm {
        title: @tr("Aggiornare a Wheelor {}?", root.update-version);
        text: @tr("Scarica l'aggiornamento ({}) e lo installa: Wheelor si chiude per qualche secondo e riparte da solo. Ruote, azioni e impostazioni restano come sono.", root.update-size);
        note: root.dirty ? @tr("Prima vengono salvate le modifiche in corso.") : "";
        glyph: "\u{E896}";
        confirm-text: root.dirty ? @tr("Salva e aggiorna") : @tr("Aggiorna");
        dismissed => { root.cancel-update(); }
        confirmed => { root.confirm-update(); }
        Btn {
            text: @tr("Novità");
            glyph: "\u{E8A7}";
            clicked => { root.open-release-notes(); }
        }
    }
    if root.update-state >= 3: Dialog {
        card-width: 420px;
        // Non si annulla: il download è breve e l'installazione parte da sola.
        HorizontalLayout {
            spacing: 16px;
            VerticalLayout {
                alignment: start;
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: Theme.accent-soft;
                    Glyph {
                        text: "\u{E896}";
                        font-size: 17px;
                        color: Theme.accent;
                    }
                }
            }
            VerticalLayout {
                spacing: 12px;
                horizontal-stretch: 1;
                Text {
                    text: root.update-state == 3 ? @tr("Download di Wheelor {}…", root.update-version) : @tr("Avvio dell'installazione…");
                    font-size: 17px;
                    font-weight: 600;
                    color: Theme.heading;
                }
                Rectangle {
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.press;
                    Rectangle {
                        x: 0px;
                        width: parent.width * (root.update-state == 3 ? root.update-progress : 1);
                        border-radius: 3px;
                        background: Theme.accent;
                        animate width { duration: 160ms; }
                    }
                }
                Hint {
                    text: root.update-state == 3 ? @tr("{}% di {}", round(root.update-progress * 100), root.update-size) : @tr("Wheelor si chiude e riparte aggiornato.");
                }
            }
        }
    }

    // ── Conferma alla chiusura con modifiche non salvate ────────────────────────
    if root.confirm-close: Confirm {
        title: @tr("Ci sono modifiche non salvate");
        text: @tr("Salvale prima di chiudere, oppure esci e lasciale perdere.");
        glyph: "\u{E74E}";
        confirm-text: @tr("Salva ed esci");
        dismissed => { root.confirm-close = false; }
        confirmed => {
            root.save();
            if !root.dirty {
                root.close-without-saving();
            }
        }
        Btn {
            text: @tr("Esci senza salvare");
            tone: Tone.danger;
            clicked => { root.close-without-saving(); }
        }
    }

    // ── Ciò che si sta trascinando, sopra a tutto ──────────────────────────────
    if Drag.active: Ghost { }
}

// La piccola finestra dei segnaposto {ask:…}: mentre un'azione è in corso chiede un testo
// (`wheelor.exe --ask`, vedi settings::ask). Invio conferma, Esc annulla l'azione.
export component AskWindow inherits Window {
    in property <string> question;
    in-out property <string> answer;
    callback accepted();
    callback cancelled();

    title: "Wheelor";
    no-frame: true;
    always-on-top: true;
    width: 440px;
    background: Theme.raised;
    default-font-size: 14px;
    init => {
        Palette.color-scheme = ColorScheme.dark;
        field.focus();
    }

    Rectangle {
        border-width: 1px;
        border-color: Theme.card-border;
    }
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancelled();
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            padding: 20px;
            spacing: 14px;
            HorizontalLayout {
                spacing: 10px;
                Logo {
                    width: 20px;
                    height: 20px;
                }
                Text {
                    text: "Wheelor";
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                    color: Theme.faint;
                }
            }
            Text {
                text: root.question;
                font-size: 17px;
                font-weight: 600;
                wrap: word-wrap;
                color: Theme.heading;
            }
            field := LineEdit {
                text <=> root.answer;
                accepted(text) => { root.accepted(); }
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        root.cancelled();
                        return accept;
                    }
                    return reject;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Btn {
                    text: @tr("Annulla");
                    clicked => { root.cancelled(); }
                }
                Btn {
                    text: "OK";
                    tone: Tone.primary;
                    clicked => { root.accepted(); }
                }
            }
        }
    }
}
